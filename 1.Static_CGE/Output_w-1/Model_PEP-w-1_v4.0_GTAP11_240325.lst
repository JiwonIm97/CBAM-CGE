3738  *==============================================================================
3739  *   5.3.7 Gross domestic product
3740  *==============================================================================
3741   EQ81(z)..       GDP_BP(z) =e= SUM[j,PVA(j,z)*VA(j,z)]+TIPT(z);
3742   
3743   EQ82(z)..       GDP_MP(z) =e= GDP_BP(z)+TPRCTS(z);
3744   
3745   EQ83(z)..       GDP_IB(z) =e= SUM[(l,j)$LDO(l,j,z),W(l,z)*LD(l,j,z)]
3746                                +SUM[(k,j)$KDO(k,j,z),R(k,j,z)*KD(k,j,z)]
3747                                +TPRCTS(z)+TPRODN(z);
3748   
3749   EQ84(z)..       GDP_FD(z) =e=
3750                   SUM[i,PC(i,z)*(C(i,z)+CG(i,z)+INV(i,z))]
3751                  +SUM[(i,zj)$EXO(i,z,zj),e(z)*PWX(i,z,zj)*EX(i,z,zj)]
3752                  +SUM[i$MRGNO(i,z),e(z)*PWMG(i)*MRGN(i,z)]
3753                  -SUM[(i,zj)$IMO(i,zj,z),e(z)*IM(i,zj,z)
3754                      *(PWM(i,zj,z)+SUM[ij,PWMG(ij)*tmrg(ij,i,zj,z)])]-TCTAX(z)-TCBAM(z);
3755   
3756   EQ85..          GDP_BP_W =e= SUM[z,GDP_BP(z)/e(z)];
