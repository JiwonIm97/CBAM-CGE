****         text of a declaration. Check symbol reference list.
2382   CO2IO(p_gas,j,z)$Gas_DIO(p_gas,j,z)  = Gas_DIO(p_gas,j,z)*41.868*GHGsEF(p_gas,'CO2EF')*1*(44/12)*0.001*GWP('CO2EF') ;
2383   CO2IO(p_oilproduct,j,z)$Oilp_DIO(p_oilproduct,j,z)  = Oilp_DIO(p_oilproduct,j,z)*41.868*GHGsEF(p_oilproduct,'CO2EF')*1*(44/12)*0.001*GWP('CO2EF') ;
2384   
2385   CO2HO(p_coal,z)$Coal_CO(p_coal,z) = Coal_CO(p_coal,z)*41.868*GHGsEF(p_coal,'CO2EF')*1*(44/12)*0.001*GWP('CO2EF') ;
2386   CO2HO(p_gas,z)$Gas_CO(p_gas,z) = Gas_CO(p_gas,z)*41.868*GHGsEF(p_gas,'CO2EF')*1*(44/12)*0.001*GWP('CO2EF') ;
2387   CO2HO(p_oilproduct,z)$Oilp_CO(p_oilproduct,z) = Oilp_CO(p_oilproduct,z)*41.868*GHGsEF(p_oilproduct,'CO2EF')*1*(44/12)*0.001*GWP('CO2EF') ;
2388   
2389  ***Indirect emissions
2390   CO2IO(p_elec,j,z) = {sum((p_coal,elec),CO2IO(p_coal,elec,z))+sum((p_oilproduct,elec),CO2IO(p_oilproduct,elec,z))+sum((p_gas,elec),CO2IO(p_gas,elec,z))}*{sum(p_elecheat,Elec_DIO(p_elecheat,j,z))/sum((p_elecheat,jj),Elec_DIO(p_elecheat,jj,z))};
2391   
2392  ***Total emissions
2393   TCO2IO(j,z)  = sum(product, CO2IO(product,j,z));
2394   
2395   
2396   
2397  ***carbon content
2398  * CO2ICO(j,zj) = TCO2IO(j,zj)/(XSTO(j,zj)*10**7);
2399   XSTO2(i,zj)  = sum(j$(INDtoCOM(j,i)),XSTO(j,zj));
2400   TCO2IO2(i,z) = sum(j$(INDtoCOM(j,i)),TCO2IO(j,z));
2401   CO2ICO(i,zj) = TCO2IO2(i,zj)/(XSTO2(i,zj)*10**7);
2402   CO2ICO(i3,zj) =0 ;
2403   CP0(z)=0;
2404   
2405  * CH4IO(p_coal,j,z)$Coal_DIO(p_coal,j,z) = Coal_DIO(p_coal,j,z)*41.868*GHGsEF(p_coal,'CH4EF')*1000*0.000001*GWP('CH4EF') ;
2406  * CH4IO(p_gas,j,z)$Gas_DIO(p_gas,j,z)  = Gas_DIO(p_gas,j,z)*41.868*GHGsEF(p_gas,'CH4EF')*1000*0.000001*GWP('CH4EF') ;
2407  * CH4IO(p_oilproduct,j,z)$Oilp_DIO(p_oilproduct,j,z) = Oilp_DIO(p_oilproduct,j,z)*41.868*GHGsEF(p_oilproduct,'CH4EF')*1000*0.000001*GWP('CH4EF') ;
2408   
2409  * CH4HO(p_coal,z)$Coal_CO(p_coal,z) = Coal_CO(p_coal,z)*41.868*GHGsEF(p_coal,'CH4EF')*1000*0.000001*GWP('CH4EF') ;
2410  * CH4HO(p_gas,z)$Gas_CO(p_gas,z) = Gas_CO(p_gas,z)*41.868*GHGsEF(p_gas,'CH4EF')*1000*0.000001*GWP('CH4EF') ;
2411  * CH4HO(p_oilproduct,z)$Oilp_CO(p_oilproduct,z) = Oilp_CO(p_oilproduct,z)*41.868*GHGsEF(p_oilproduct,'CH4EF')*1000*0.000001*GWP('CH4EF') ;
2412   
2413  * N2OIO(p_coal,j,z)$Coal_DIO(p_coal,j,z) = Coal_DIO(p_coal,j,z)*41.868*GHGsEF(p_coal,'N2OEF')*1000*0.000001*GWP('N2OEF') ;
2414  * N2OIO(p_gas,j,z)$Gas_DIO(p_gas,j,z)  = Gas_DIO(p_gas,j,z)*41.868*GHGsEF(p_gas,'N2OEF')*1000*0.000001*GWP('N2OEF') ;
2415  * N2OIO(p_oilproduct,j,z)$Oilp_DIO(p_oilproduct,j,z)  = Oilp_DIO(p_oilproduct,j,z)*41.868*GHGsEF(p_oilproduct,'N2OEF')*1000*0.000001*GWP('N2OEF') ;
2416   
2417  * N2OHO(p_coal,z)$Coal_CO(p_coal,z) = Coal_CO(p_coal,z)*41.868*GHGsEF(p_coal,'N2OEF')*1000*0.000001*GWP('N2OEF') ;
2418  * N2OHO(p_gas,z)$Gas_CO(p_gas,z) = Gas_CO(p_gas,z)*41.868*GHGsEF(p_gas,'N2OEF')*1000*0.000001*GWP('N2OEF') ;
2419  * N2OHO(p_oilproduct,z)$Oilp_CO(p_oilproduct,z) = Oilp_CO(p_oilproduct,z)*41.868*GHGsEF(p_oilproduct,'N2OEF')*1000*0.000001*GWP('N2OEF') ;
2420   
2421   
2422  *execute_unload 'cbam', CO2IO, CO2ICO, XSTO2 ;
2423  *$exit
2424  *execute_unload 'DIO_wKLEM', DEO, DIO ;
2425   
2426  *==============================================================================
2427  *  4.3.2 Calibration of other prices and revised volumes (part 2)
2428  *==============================================================================
2429   PDO(i,z)        = PLO(i,z)*(1+tticO(i,z));
2430   PMO(i,zj,z)     = eO(z)*(PWMO(i,zj,z)+SUM[ij,PWMGO(ij)*tmrg(ij,i,zj,z)])
2431                   *(1+ttimO(i,zj,z))*(1+tticO(i,z))*(1+CP0(zj)*CO2ICO(i,zj));
2432   PMTO(i,z)       = SUM[zj,PMO(i,zj,z)*IMO(i,zj,z)]/IMTO(i,z);
2433   PCO(i,z)        = [PMTO(i,z)*IMTO(i,z)+PDO(i,z)*DDO(i,z)]/QO(i,z);
2434   
2435   CO(i,z)         = CO(i,z)/PCO(i,z);
2436   CGO(i,z)        = CGO(i,z)/PCO(i,z);
2437   DIO(nene,j,z)   = DIO(nene,j,z)/PCO(nene,z);
2438   DEO(ene,j,z)    = DIO(ene,j,z)/PCO(ene,z);
2439   INVO(i,z)       = INVO(i,z)/PCO(i,z);
2440   
2441   CIO(j,z)        = SUM[nene,DIO(nene,j,z)];
2442   CEO(j,z)        = SUM[ene,DEO(ene,j,z)];
2443   
2444   DITO(nene,z)     = SUM[j,DIO(nene,j,z)];
2445   DITO(ene,z)      = SUM[j,DEO(ene,j,z)];
2446   
2447   PO4(ene,j,z)    = PCO(ene,z);
2448   
2449   PCIO(j,z)       = SUM[nene,PCO(nene,z)*DIO(nene,j,z)]/CIO(j,z);
2450   PCEO(j,z)       = SUM[ene,PCO(ene,z)*DEO(ene,j,z)]/CEO(j,z) ;
2451   
2452   WTIO(l,j,z)     = WO(l,z)*(1+ttiwO(l,j,z));
2453   
2454   WCO(j,z)$LDCO(j,z)
2455                   = SUM[l,WTIO(l,j,z)*LDO(l,j,z)]/LDCO(j,z);
2456   
2457  *==============================================================================
2458  *  4.3.3 Calibration of other prices and revised volumes (part 3)
2459  *==============================================================================
2460  * The price of capital is arbitrary:
2461   PKO(z) = 1;
2462   
2463  * The calibration of depreciation rates is based on two hypotheses:
2464  * 1. The rate of depreciation is the same for all types of capital and all
2465  *    industries in each region (this hypothesis is made to accommodate the fact
2466  *    that, in the GTAP data base, capital consumption allowance is not detailed;
2467  *    as a matter of fact, the GTAP capital consumption allowance is set at
2468  *    4% of the value of the capital stock).
2469  * 2. The rental rate of capital is uniform across industries and types of
2470  *    capital in each region.
2471  * These hypotheses lead to the following formula:
2472   
2473  * From GTAP, we know KSTO.
2474   KSTO(z)         = KSTO(z)/PKO(z);
2475   
2476  * Assuming a uniform depreciation rate for all types
2477  * of capital and all industries:
2478   delta(z)        = DEPO(z)/[PKO(z)*KSTO(z)];
2479   
2480  display delta, DEPO, PKO, KSTO, PMO;
2481  *$EXIT
2482  * From GTAP, we know KSTO. Assuming a uniform rental rate R for all types
2483  * of capital and all industries:
2484   RKO(k,z)        = SUM[(kj,jj),RKDO(kj,jj,z)]/KSTO(z);
2485   RKO(k,z)        =1;
2486   
2487   RO(k,j,z)$RKDO(k,j,z)
2488                   = RKO(k,z);
2489   
2490  * Then from the GTAP value of income paid to capital RKD we calibrate KDO:
2491   KDO(k,j,z)$RKDO(k,j,z)
2492                   = RKDO(k,j,z)/RO(k,j,z);
2493   
2494  * The supply of capital is equal to demand:
2495   KSO(k,z)        = SUM[j,KDO(k,j,z)];
2496   
2497   A_K(z)          = 1/PKO(z)*{PROD[i$gamma_INV(i,z),(PCO(i,Z)/gamma_INV(i,z))
2498                     **gamma_INV(i,z)]};
2499   
2500   KDCO(j,z)       = SUM[k,KDO(k,j,z)];
2501   RTIO(k,j,z)     = RO(k,j,z)*(1+ttikO(k,j,z));
2502   RCO(j,z)$KDCO(j,z)
2503                   = SUM[k,RTIO(k,j,z)*KDO(k,j,z)]/KDCO(j,z);
2504   
2505  *==============================================================================
2506  *  4.3.4 Calibration of other prices and revised volumes (part 4)
2507  *==============================================================================
2508   VAO(j,z)        = LDCO(j,z)+KDCO(j,z);
2509   
2510   
2511   
2512   PVAO(j,z)       = [WCO(j,z)*LDCO(j,z)+RCO(j,z)*KDCO(j,z)]/VAO(j,z);
2513   
2514  * PIXGDPO is tautologically equal to 1, based on its formula
2515  * PIXGDPO(z)      = {SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
2516  *                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
2517  *                   *SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
2518  *                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]}**0.5;
2519   PIXGDPO(z)      = 1;
2520   
2521  * PIXGDP_WO is tautologically equal to 1, based on its formula
2522  * PIXGDP_WO       = {SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
2523  *                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
2524  *                   *SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
2525  *                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]/eO(z)}**0.5;
2526   PIXGDP_WO       = 1;
2527   
2528  * PIXCONO(z) is tautologically equal to 1, based on its formula
2529  * PIXCONO(z)      = SUM[i,PCO(i,z)*CO(i,z)]
2530  *                  /SUM[i,PCO(i,z)*CO(i,z)];
2531   PIXCONO(z)      = 1;
2532   
2533  * PIXINVO(z) is tautologically equal to 1, based on its formula
2534  * PIXINVO(z)      = PROD[i$gamma_INV(i,z),(PCO(i,z)/PCO(i,z))**gamma_INV(i,z)];
2535   PIXINVO(z)      = 1;
2536   
2537  * PIXGVTO(z) is tautologically equal to 1, based on its formula
2538  * PIXGVTO(z)      = PROD[i$gamma_GVT(i,z),(PCO(i,z)/PCO(i,z))**gamma_GVT(i,z)];
2539   PIXGVTO(z)      = 1;
2540   
2541  *==============================================================================
2542  *  4.4 Calibration of function parameters
2543  *==============================================================================
2544  *   4.4.1 Leontief functions
2545  *==============================================================================
2546   io(j,z)         = CIO(j,z)/XSTO(j,z) ;
2547   
2548   io2(j,z)        = CEO(j,z)/XSTO(j,z) ;
2549   
2550   v(j,z)          = VAO(j,z)/XSTO(j,z) ;
2551   
2552   v2(j,z)         = (CEO(j,z)+VAO(j,z))/XSTO(j,z) ;
2553   
2554   aij(nene,j,z)   = DIO(nene,j,z)/CIO(j,z);
2555  * aij2(ene,j,z)   = DIO(ene,j,z)/CEO(j,z);
2556   aij2(ene,j,z)   = DEO(ene,j,z)/CEO(j,z);
2557   
2558  *==============================================================================
2559  *   4.4.2 Calibration of CET parameters
2560  *==============================================================================
2561  *    4.4.2.0 CET between total exports and local production
2562  *==============================================================================
2563  * rho_X0(j,z)       = (1+sigma_X0(j,z))/sigma_X0(j,z);
2564   
2565  * beta_X0(j,i,z)$XSO(j,i,z)
2566  *                 = PO2(j,i,z)*XSO(j,i,z)**(1-rho_X0(j,z))/
2567  *                   SUM[ij$XSO(j,ij,z),PO2(j,ij,z)*XSO(j,ij,z)**(1-rho_X0(j,z))];
2568   
2569  * B_X0(j,z)       = XSTO(j,z)
2570  *                  /SUM[ij$XSO(j,ij,z),beta_X0(j,ij,z)*XSO(j,ij,z)**rho_X0(j,z)
2571  *                  ]**(1/rho_X0(j,z));
2572   
2573  *sigma_X1(i,z) = 1;
2574  *==============================================================================
2575  *    4.4.2.1 CET between total exports, domestic supply and margins
2576  *==============================================================================
2577   rho_X1(i,z)     = (1+sigma_X1(i,z))/sigma_X1(i,z);
2578   
2579   beta_EX_X1(i,z)$MRGNO(i,z)
2580                   = [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))]/
2581                     [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))+
2582                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))+
2583                     eO(z)*PWMGO(i)*MRGNO(i,z)$MRGNO(i,z)**(1-rho_X1(i,z))+Tiny];
2584   
2585   beta_EX_X1(i,z)$(MRGNO(i,z) eq 0)
2586                   = [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))]/
2587                     [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))+
2588                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))+Tiny];
2589   
2590   beta_D_X1(i,z)$MRGNO(i,z)
2591                   = [PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))]/
2592                     [PETO(i,z)*EXTO(i,z)**(1-rho_X1(i,z))+
2593                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))+
2594                     eO(z)*PWMGO(i)*MRGNO(i,z)**(1-rho_X1(i,z))];
2595   
2596   beta_D_X1(i,z)$(MRGNO(i,z) eq 0)
2597                   = [PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))]/
2598                     [PETO(i,z)*EXTO(i,z)**(1-rho_X1(i,z))+
2599                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))];
2600   
2601   B_X1(i,z)       = XSO_I(i,z)/[beta_EX_X1(i,z)*EXTO(i,z)**rho_X1(i,z)
2602                    +beta_D_X1(i,z)*DSO_I(i,z)**rho_X1(i,z)+(1-beta_EX_X1(i,z)
2603                    -beta_D_X1(i,z))*MRGNO(i,z)**rho_X1(i,z)]**(1/rho_X1(i,z));
2604   
2605  *==============================================================================
2606  *    4.4.2.2 CET between exports to different trading partners
2607  *==============================================================================
2608   rho_X2(i,z)     = (1+sigma_X2(i,z))/sigma_X2(i,z);
2609   
2610   beta_X2(i,z,zj)$EXO(i,z,zj)
2611                   = [PEO(i,z,zj)*EXO(i,z,zj)**(1-rho_X2(i,z))]/
2612                     SUM[zjj$EXO(i,z,zjj),PEO(i,z,zjj)*EXO(i,z,zjj)
2613                     **(1-rho_X2(i,z))];
2614   B_X2(i,z)       = EXTO(i,z)/{SUM[zj,beta_X2(i,z,zj)*EXO(i,z,zj)**rho_X2(i,z)]
2615                     **(1/rho_X2(i,z))};
2616   
2617  display IMO, EXO, rho_X2, PEO ;
2618  *$exit
2619   
2620  *==============================================================================
2621  *   4.4.3 Calibration of CES parameters
2622  *==============================================================================
2623  *    4.4.3.0 Composite output
2624  *==============================================================================
2625   rho_X3(i,z)   = (1-sigma_X3(i,z))/sigma_X3(i,z);
2626   
2627   beta_X3(j,i,z)$XSO(j,i,z)
2628                 = [PO2(j,i,z)*XSO(j,i,z)**(1+rho_X3(i,z))]/
2629                     SUM[jj$XSO(jj,i,z),PO2(jj,i,z)*XSO(jj,i,z)**(1+rho_X3(i,z))];
2630   
2631   B_X3(i,z)     = XSO_I(i,z)
2632                    /SUM[jj$XSO(jj,i,z),beta_X3(jj,i,z)*XSO(jj,i,z)**(-rho_X3(i,z))
2633                    ]**(-1/rho_X3(i,z));
2634   
2635   POWERQO(Z) = SUM(POWER, XSO(power,'18_ELEC',z));
2636   
2637  * sigma_X4(z) = 1.5;
2638   
2639   sigma_X4(z) = 2;
2640   
2641   
2642   rho_X4(z)   = (1-sigma_X4(z))/sigma_X4(z);
2643   
2644   beta_X4(power,z)
2645                 = [PO2(power,'18_ELEC',z)*XSO(power,'18_ELEC',z)**(1+rho_X4(z))]/
2646                     SUM[power2$XSO(power2,'18_ELEC',z),PO2(power2,'18_ELEC',z)*XSO(power2,'18_ELEC',z)**(1+rho_X4(z))];
2647   
2648   B_X4(z)     = POWERQO(Z)
2649                    /SUM[power2$XSO(power2,'18_ELEC',z),beta_X4(power2,z)*XSO(power2,'18_ELEC',z)**(-rho_X4(z))
2650                    ]**(-1/rho_X4(z));
2651   
2652   TnDShare(z) = XSO('18_TnD','18_ELEC',z) / XSO_I('18_ELEC',z);
2653   
2654   PPOWERO(z) = 1;
2655   
2656  *==============================================================================
2657  *    4.4.3.1 Composite good
2658  *==============================================================================
2659   rho_M1(i,z)     = (1-sigma_m1(i,z))/sigma_m1(i,z);
2660   beta_M1(i,z)    = PMTO(i,z)*IMTO(i,z)**(rho_M1(i,z)+1)/
2661                    {PDO(i,z)*DDO(i,z)**(rho_M1(i,z)+1)
2662                    +PMTO(i,z)*IMTO(i,z)**(rho_M1(i,z)+1)};
2663   B_M1(i,z)       = QO(i,z)/{beta_M1(i,z)*IMTO(i,z)**(-rho_M1(i,z))
2664                    +(1-beta_M1(i,z))*DDO(i,z)**(-rho_M1(i,z))}**(-1/rho_M1(i,z));
2665   
2666  *==============================================================================
2667  *    4.4.3.2 CES between imports from different trading partners
2668  *==============================================================================
2669   rho_M2(i,z)     = (1-sigma_M2(i,z))/sigma_M2(i,z);
2670   beta_M2(i,zj,z)$IMO(i,zj,z)
2671                   = [PMO(i,zj,z)*IMO(i,zj,z)**(rho_M2(i,z)+1)]/
2672                     SUM[zjj$IMO(i,zjj,z),PMO(i,zjj,z)*IMO(i,zjj,z)
2673                      **(rho_M2(i,z)+1)];
2674   B_M2(i,z)       = IMTO(i,z)/{SUM[zj$IMO(i,zj,z),beta_M2(i,zj,z)*IMO(i,zj,z)
2675                     **(-rho_M2(i,z))]**(-1/rho_M2(i,z))};
2676   
2677  *==============================================================================
2678  *    4.4.3.3 Composite capital
2679  *==============================================================================
2680   rho_KD(j,z)     = (1-sigma_KD(j,z))/sigma_KD(j,z);
2681   
2682   beta_KD(k,j,z)$KDO(k,j,z)
2683                   = [RTIO(k,j,z)*KDO(k,j,z)**(1+rho_KD(j,z))]/
2684                     SUM[kj$KDO(kj,j,z),RTIO(kj,j,z)*KDO(kj,j,z)**(1+rho_KD(j,z))];
2685   B_KD(j,z)$KDCO(j,z)
2686                   = KDCO(j,z)/{SUM[k$KDO(k,j,z),beta_KD(k,j,z)*KDO(k,j,z)
2687                     **(-rho_KD(j,z))]**(-1/rho_KD(j,z))};
2688   
2689  *==============================================================================
2690  *    4.4.3.4 Composite labor
2691  *==============================================================================
2692   rho_LD(j,z)     = (1-sigma_LD(j,z))/sigma_LD(j,z);
2693   beta_LD(l,j,z)$LDO(l,j,z)
2694                   = [WTIO(l,j,z)*LDO(l,j,z)**(1+rho_LD(j,z))]/
2695                     SUM[lj$LDO(lj,j,z),WTIO(lj,j,z)*LDO(lj,j,z)
2696                     **(1+rho_LD(j,z))];
2697   B_LD(j,z)$LDCO(j,z)
2698                   = LDCO(j,z)/{SUM[l$LDO(l,j,z),beta_LD(l,j,z)*LDO(l,j,z)
2699                     **(-rho_LD(j,z))]**(-1/rho_LD(j,z))};
2700   
2701  *===============================================================================
2702  *   Composite E
2703  *===============================================================================
2704   rho_ENER(j,z)   = (1-sigma_ENER(j,z))/sigma_ENER(j,z);
2705   
2706   beta_ENER(ene,j,z)$DEO(ene,j,z)
2707                   = [PO4(ene,j,z)*DEO(ene,j,z)**(1+rho_ENER(j,z))]/
2708                     SUM[ene2$DIO(ene,j,z),DEO(ene2,j,z)**(1+rho_ENER(j,z))];
2709   
2710   B_ENER(j,z)$CEO(j,z)
2711                   = CEO(j,z)/{SUM[ene$DEO(ene,j,z),beta_ENER(ene,j,z)*DEO(ene,j,z)
2712                     **(-rho_ENER(j,z))]**(-1/rho_ENER(j,z))};
2713   
2714  *==============================================================================
2715  *    4.4.3.5 Value added
2716  *==============================================================================
2717   sigma_VA('10_PETROLCOAL',z) = 1.260;
2718   rho_VA(j,z)     = (1-sigma_VA(j,z))/sigma_VA(j,z);
2719   
2720  display rho_VA, sigma_VA ;
2721   
2722   beta_VA(j,z)$KDCO(j,z)
2723                   = WCO(j,z)*LDCO(j,z)**(rho_VA(j,z)+1)/
2724                    {WCO(j,z)*LDCO(j,z)**(rho_VA(j,z)+1)+
2725                     RCO(j,z)*KDCO(j,z)**(rho_VA(j,z)+1)};
2726   B_VA(j,z)$KDCO(j,z)
2727                   = VAO(j,z)
2728                     /{[beta_VA(j,z)*LDCO(j,z)**(-rho_VA(j,z))+
2729                     (1-beta_VA(j,z))*KDCO(j,z)**(-rho_VA(j,z))
2730                     ]**(-1/rho_VA(j,z))};
2731   
2732  *                   /{[(1-beta_VA(j,z))*KDCO(j,z)**(-rho_VA(j,z))
2733  *                   ]**(-1/rho_VA(j,z))};
2734   
2735  *$exit
2736  *==============================================================================
2737  *    Composite KLE
2738  *==============================================================================
2739   KLEO(j,z)       = CEO(j,z) + VAO(j,z) ;
2740   
2741   PKLEO(j,z)      = [PCEO(j,z)*CEO(j,z)+PVAO(j,z)*VAO(j,z)]/KLEO(j,z);
2742   
2743   rho_KLE(j,z)    = (1-sigma_KLE(j,z))/sigma_KLE(j,z);
2744   
2745   beta_KLE(j,z)$KLEO(j,z)
2746                   = PVAO(j,z)*VAO(j,z)**(rho_KLE(j,z)+1)/
2747                    {PVAO(j,z)*VAO(j,z)**(rho_KLE(j,z)+1)+
2748                     PCEO(j,z)*CEO(j,z)**(rho_KLE(j,z)+1)};
2749   
2750   B_KLE(j,z)$KLEO(j,z)
2751                   = KLEO(j,z)
2752                     /{[beta_KLE(j,z)*VAO(j,z)**(-rho_KLE(j,z))+
2753                     (1-beta_KLE(j,z))*CEO(j,z)**(-rho_KLE(j,z))
2754                     ]**(-1/rho_KLE(j,z))};
2755   
2756  *==============================================================================
2757  *   4.4.4 Calibration of LES parameters
2758  *==============================================================================
2759  *   As the assigned values of income elasticities may not result in
2760  *   consumption shares that add up to 1, this first step
2761  *   adjusts the elasticities proportionally
2762   sigma_Y(i,z)    = sigma_Y(i,z)/{SUM[ij,sigma_Y(ij,z)*PCO(ij,z)*CO(ij,z)]
2763                     /CTHO(z)};
2764   gamma_LES(i,z)  = PCO(i,z)*CO(i,z)*sigma_Y(i,z)/CTHO(z);
2765   CMINO(i,z)      = CO(i,z)+gamma_LES(i,z)*CTHO(z)/{PCO(i,z)*frisch(z)};
2766   
2767  *==============================================================================
2768  *  4.5 Calibration of gross domestic products
2769  *==============================================================================
2770   GDP_BPO(z)      = SUM[j,PVAO(j,z)*VAO(j,z)]+TIPTO(z);
2771   GDP_MPO(z)      = GDP_BPO(z)+TPRCTSO(z);
2772   GDP_IBO(z)      = SUM[(l,j),WO(l,z)*LDO(l,j,z)]+SUM[(k,j),RO(k,j,z)*KDO(k,j,z)]
2773                     +TPRODNO(z)+TPRCTSO(z);
2774   GDP_FDO(z)      = SUM[i,PCO(i,z)*(CO(i,z)+CGO(i,z)+INVO(i,z))]
2775                    +eO(z)*SUM[(i,zj),PWXO(i,z,zj)*EXO(i,z,zj)]
2776                    +eO(z)*SUM[i,PWMGO(i)*MRGNO(i,z)]
2777                    -eO(z)*SUM[(i,zj),IMO(i,zj,z)*(PWMO(i,zj,z)
2778                    +SUM{ij,PWMGO(ij)*tmrg(ij,i,zj,z)})];
2779   GDP_BP_WO       = SUM[z,GDP_BPO(z)/eO(z)];
2780   
2781  *==============================================================================
2782  *  4.5 Calibration of real (volume) variables computed from price indices
2783  *==============================================================================
2784   CABXO(z)        = CABO(z)/[PIXGDP_WO*eO(z)];
2785   CTH_REALO(z)    = CTHO(z)/PIXCONO(z);
2786   G_REALO(z)      = GO(z)/PIXGVTO(z);
2787   GDP_BP_REALO(z) = GDP_BPO(z)/PIXGDPO(z);
2788   GDP_BP_W_REALO  = GDP_BP_WO/PIXGDP_WO;
2789   GDP_MP_REALO(z) = GDP_MPO(z)/PIXCONO(z);
2790   IT_REALO(z)     = ITO(z)/PIXINVO(z);
2791   
2792  *==============================================================================
2793  *  4.7 Parameters of the household savings function
2794  *==============================================================================
2795   sh1O(z)         = [SHO(z)+SGO(z)]/GDP_IBO(z);
2796   sh0O(z)         = SHO(z)-sh1O(z)*YDHO(z);
2797   
2798  *==============================================================================
2799  *  4.8 Calibration of indexed transfers and parameters
2800  *==============================================================================
2801   ttdh0O(z)       = ttdh0O(z)/PIXCONO(z)**eta;
2802   sh0O(z)         = sh0O(z)/PIXCONO(z)**eta;
2803   
2804   
2805  *==============================================================================
2806  *  4.10 Energy
2807  *==============================================================================
2808  Parameter
2809   EEI(product,j,z)  Energy intensity by industry sector ktoe per 10 billion $
2810   NEI(product,j,z)  Non-Energy intensity by production sectos ktoe per 10 billion $
2811   EHI(product,z)    Energy intensity by household ktoe per 10 billion $
2812   
2813   EEO(product,j,z)  Initial Industry energy consumption in region z ktoe
2814   NEO(product,j,z)  Initial Industry non energy consumption in region z ktoe
2815   EHO(product,z)    Initial Household energy consumption in region z ktoe
2816  ;
2817   
2818   EEI(p_coal,j,z)$(DEO('02_COAL',j,z) gt 0)               = Coal_DIO(p_coal,j,z)/DEO('02_COAL',j,z);
2819   EEI(p_oil,j,z)$(DEO('03_OIL',j,z) gt 0)                 = Oil_DIO(p_oil,j,z)/DEO('03_OIL',j,z);
2820   EEI(p_gas,j,z)$(DEO('04_GAS',j,z) gt 0)                 = Gas_DIO(p_gas,j,z)/DEO('04_GAS',j,z);
2821   EEI(p_oilproduct,j,z)$(DEO('10_PETROLCOAL',j,z) gt 0)   = Oilp_DIO(p_oilproduct,j,z)/DEO('10_PETROLCOAL',j,z);
2822   EEI(p_elecheat,j,z)$(DEO('18_ELEC',j,z) gt 0)           = Elec_DIO(p_elecheat,j,z)/DEO('18_ELEC',j,z);
2823   
2824   NEI(p_coal,j,z)$(DEO('02_COAL',j,z) gt 0)              = NCoal_DIO(p_coal,j,z)/DEO('02_COAL',j,z);
2825   NEI(p_oil,j,z)$(DEO('03_OIL',j,z) gt 0)                = NOil_DIO(p_oil,j,z)/DEO('03_OIL',j,z);
2826   NEI(p_gas,j,z)$(DEO('04_GAS',j,z) gt 0)                = NGas_DIO(p_gas,j,z)/DEO('04_GAS',j,z);
2827   NEI(p_oilproduct,j,z)$(DEO('10_PETROLCOAL',j,z) gt 0)  = NOilp_DIO(p_oilproduct,j,z)/DEO('10_PETROLCOAL',j,z);
2828   
2829   EHI(p_coal,z)$(CO('02_COAL',z) gt 0)                    = Coal_CO(p_coal,z)/CO('02_COAL',z);
2830   EHI(p_oil,z)$(CO('03_OIL',z) gt 0)                      = Oil_CO(p_oil,z)/CO('03_OIL',z);
2831   EHI(p_gas,z)$(CO('04_GAS',z) gt 0)                      = Gas_CO(p_gas,z)/CO('04_GAS',z);
2832   EHI(p_oilproduct,z)$(CO('10_PETROLCOAL',z) gt 0)        = Oilp_CO(p_oilproduct,z)/CO('10_PETROLCOAL',z);
2833   EHI(p_elecheat,z)$(CO('18_ELEC',z) gt 0)                = Elec_CO(p_elecheat,z)/CO('18_ELEC',z);
2834   
2835   EEO(p_coal,j,z)       = Coal_DIO(p_coal,j,z) ;
2836   EEO(p_gas,j,z)        = Gas_DIO(p_gas,j,z) ;
2837   EEO(p_oil,j,z)        = Oil_DIO(p_oil,j,z) ;
2838   EEO(p_oilproduct,j,z) = Oilp_DIO(p_oilproduct,j,z) ;
2839   EEO(p_elecheat,j,z)   = Elec_DIO(p_elecheat,j,z) ;
2840   
2841   NEO(p_coal,j,z)       = NCoal_DIO(p_coal,j,z) ;
2842   NEO(p_gas,j,z)        = NGas_DIO(p_gas,j,z) ;
2843   NEO(p_oilproduct,j,z) = NOilp_DIO(p_oilproduct,j,z) ;
2844   
2845   
2846   EHO(p_coal,z)         = Coal_CO(p_coal,z) ;
2847   EHO(p_gas,z)          = Gas_CO(p_gas,z) ;
2848   EHO(p_oil,z)          = Oil_CO(p_oil,z) ;
2849   EHO(p_oilproduct,z)   = Oilp_CO(p_oilproduct,z) ;
2850   EHO(p_elecheat,z)     = Elec_CO(p_elecheat,z) ;
2851   
2852  *display EEI, EHI, EEO, NEO, EHO, GDPPPP, GHGsEF, CO2HO ;
2853  *execute_unload 'GHGs emission',
2854  *CO2HO, CO2IO, CH4IO, CH4HO, N2OIO, N2OHO
2855   
2856  *==============================================================================
2857  *  4.11 CO2FACTOR and CTAX
2858  *==============================================================================
2859  Parameters
2860   CO2FACTOR(ene,j,z)     CO2 emissions factor (tCO2 per 100$)
2861   CTAX0(z)               initial Carbon tax 100$ per ton CO2
2862   TCTAX0(z)              initial Government Revenue from Carbon tax
2863  ;
2864   
2865   CO2FACTOR(ene,j,z) = 0 ;
2866   CO2FACTOR('02_COAL',j,z)$DEO('02_COAL',j,z) = [sum(p_coal,CO2IO(p_coal,j,z))/DEO('02_COAL',j,z)]*(1000/(10**8));
2867   CO2FACTOR('04_GAS',j,z)$DEO('04_GAS',j,z) = [sum(p_gas,CO2IO(p_gas,j,z))/DEO('04_GAS',j,z)]*(1000/(10**8));
2868   CO2FACTOR('10_PETROLCOAL',j,z)$DEO('10_PETROLCOAL',j,z) = [sum(p_oilproduct,CO2IO(p_oilproduct,j,z))/DEO('10_PETROLCOAL',j,z)]*(1000/(10**8));
2869   
2870   CO2FACTOR('10_PETROLCOAL','10_PETROLCOAL',z) = 0;
2871   
2872   CTAX0(z) = 0 ;
2873   TCTAX0(z) = 0;
2874   
2875  *execute_unload 'CO2FACTOR_w-1_GTAP11', CO2FACTOR ;
2876  *execute_unload 'calibration_0723'  ;
2877  *$exit
2878   
