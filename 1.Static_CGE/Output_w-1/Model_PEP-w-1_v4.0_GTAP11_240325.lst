3351  *==============================================================================
3352  *  5.3 Equations
3353  *==============================================================================
3354  *   5.3.1 Production
3355  *==============================================================================
3356   EQ1(j3,z)..     VA(j3,z) =e= v(j3,z)*XST(j3,z);
3357   
3358   EQ1_1(j2,z)..   KLE(j2,z) =e= v2(j2,z)*XST(j2,z);
3359   
3360   EQ2(j,z)..      CI(j,z) =e= io(j,z)*XST(j,z);
3361   
3362   EQ2_1(j3,z)..   CE(j3,z) =e= io2(j3,z)*XST(j3,z);
3363   
3364   EQ3(j,z)..      VA(j,z) =e= B_VA(j,z)*{
3365                      [beta_VA(j,z)*LDC(j,z)**(-rho_VA(j,z))]$LDCO(j,z)
3366                     +[(1-beta_VA(j,z))*KDC(j,z)**(-rho_VA(j,z))]$KDCO(j,z)
3367                                                     }**(-1/rho_VA(j,z));
3368   
3369   EQ3_1(j2,z)..     KLE(j2,z) =e= B_KLE(j2,z)*{
3370                      [beta_KLE(j2,z)*VA(j2,z)**(-rho_KLE(j2,z))]$VAO(j2,z)
3371                     +[(1-beta_KLE(j2,z))*CE(j2,z)**(-rho_KLE(j2,z))]$CEO(j2,z)
3372                                                     }**(-1/rho_KLE(j2,z));
3373   
3374   EQ4(j,z)$[LDCO(j,z) and KDCO(j,z)]..
3375                   LDC(j,z) =e= {[beta_VA(j,z)/(1-beta_VA(j,z))]
3376                                *[RC(j,z)/WC(j,z)]}**sigma_VA(j,z)*KDC(j,z);
3377   
3378   EQ4_1(j2,z)$[VAO(j2,z) and CEO(j2,z)]..
3379                   VA(j2,z) =e= {[beta_KLE(j2,z)/(1-beta_KLE(j2,z))]
3380                                *[PCE(j2,z)/PVA(j2,z)]}**sigma_KLE(j2,z)*CE(j2,z);
3381   
3382   EQ5(j,z)$LDCO(j,z)..
3383                   LDC(j,z) =e= B_LD(j,z)*SUM[l$LDO(l,j,z),beta_LD(l,j,z)
3384                                  *LD(l,j,z)**(-rho_LD(j,z))]**(-1/rho_LD(j,z));
3385   
3386   EQ6(l,j,z)$LDO(l,j,z)..
3387                   LD(l,j,z) =e= [beta_LD(l,j,z)*WC(j,z)/WTI(l,j,z)]
3388                                 **sigma_LD(j,z)*B_LD(j,z)**(sigma_LD(j,z)-1)
3389                                 *LDC(j,z);
3390   
3391   EQ7(j,z)$KDCO(j,z)..
3392                   KDC(j,z) =e= B_KD(j,z)*SUM[k$KDO(k,j,z),beta_KD(k,j,z)
3393                                  *KD(k,j,z)**(-rho_KD(j,z))]**(-1/rho_KD(j,z));
3394   
3395   EQ8(k,j,z)$KDO(k,j,z)..
3396                   KD(k,j,z) =e= [beta_KD(k,j,z)*RC(j,z)/RTI(k,j,z)]
3397                                   **sigma_KD(j,z)*B_KD(j,z)**(sigma_KD(j,z)-1)
3398                                   *KDC(j,z);
3399   
3400   EQ9(nene,j,z)..   DI(nene,j,z) =e= aij(nene,j,z)*CI(j,z) ;
3401   
3402   EQ9_1(ene,j3,z)..  DE(ene,j3,z) =e= aij2(ene,j3,z)*CE(j3,z) ;
3403   
3404  * EQ9_1(ene,j,z)..  DE(ene,j,z) =e= [beta_ENER(ene,j,z)*PCE(j,z)/((1+CTAX(Z)*CO2FACTOR(ene,j,z))*P4(ene,j,z))]
3405  *                                   **sigma_ENER(j,z)*B_ENER(j,z)**(sigma_ENER(j,z)-1)
3406  *                                   *CE(j,z);
3407   
3408  *EQ9_2(ene,j2,z)..  DE(ene,j2,z) =e= [beta_ENER(ene,j2,z)*PCE(j2,z)/P4(ene,j2,z)]
3409  *                                   **sigma_ENER(j2,z)*B_ENER(j2,z)**(sigma_ENER(j2,z)-1)
3410  *                                   *CE(j2,z);
3411   
3412   EQ9_2(ene,j2,z)..  DE(ene,j2,z) =e= [beta_ENER(ene,j2,z)*PCE(j2,z)/((P4(ene,j2,z)+CTAX(Z)*CO2FACTOR(ene,j2,z)))]
3413                                     **sigma_ENER(j2,z)*B_ENER(j2,z)**(sigma_ENER(j2,z)-1)
3414                                     *CE(j2,z);
3415   
3416  * EQ9_2(ene,j2,z)..  DE(ene,j2,z) =e= [beta_ENER(ene,j2,z)*PCE(j2,z)/((1+CTAX(Z)*CO2FACTOR(ene,j2,z))*P4(ene,j2,z))]
3417  *                                   **sigma_ENER(j2,z)*B_ENER(j2,z)**(sigma_ENER(j2,z)-1)
3418  *                                   *CE(j2,z);
3419   
3420   
3421  * EQ9_3(j2,z)..      CE(j2,z) =e= B_ENER(j2,z)*SUM[ene$DEO(ene,j2,z),beta_ENER(ene,j2,z)
3422  *                                *DE(ene,j2,z)**(-rho_ENER(j2,z))]**(-1/rho_ENER(j2,z));
3423   
3424  *==============================================================================
3425  *   5.3.2 Income and savings
3426  *==============================================================================
3427  *    5.3.2.1 Households
3428  *==============================================================================
3429   EQ10(z3)..      YH(z3) =e= YHL(z3)+YHK(z3)+TCTAX(z3)+TCBAM(z3);
3430   EQ10_1(z4)..    YH(z4) =e= YHL(z4)+YHK(z4)+TCTAX(z4);
3431   EQ11(z)..       YHL(z) =e= SUM[(l,j)$LDO(l,j,z),W(l,z)*LD(l,j,z)];
3432   
3433   EQ12(z)..       YHK(z) =e= SUM[(k,j)$KDO(k,j,z),R(k,j,z)*KD(k,j,z)];
3434   
3435   EQ13(z)..       YDH(z) =e= YH(z)-TDH(z);
3436   
3437   EQ14(z)..       CTH(z) =e= YDH(z)-SH(z);
3438   
3439   EQ15(z)..       SH(z) =e= PIXCON(z)**eta*sh0(z)+sh1(z)*YDH(z);
3440   
3441  *==============================================================================
3442  *    5.3.2.2 Government
3443  *==============================================================================
3444  * EQ16(z)..       YG(z) =e= TDH(z)+TPRODN(z)+TPRCTS(z)+TCTAX(Z) ;
3445   
3446  * EQ16(z)..       YG(z) =e= TDH(z)+TPRODN(z)+TPRCTS(z) ;
3447   EQ16(z4)..      YG(z4)   =e= TDH(z4)+TPRODN(z4)+TPRCTS(z4)+TCTAX(z4) ;
3448   EQ16_1(z)..     TCTAX(z) =e= sum((ene,j), PC(ene,z)*CTAX(z)*CO2FACTOR(ene,j,z)*DE(ene,j,z));
3449  *eqTe(j)..       Te(j)   =e= sum(en,taue(en)*pq(en)*CO2coef(en)*X(en,j));
3450   EQ16_2(z3)..    YG(z3)   =e= TDH(z3)+TPRODN(z3)+TPRCTS(z3)+TCTAX(z3)+ TCBAM(z3);
3451  * EQ16_3(z3)..    TCBAM(z) =e= sum(j, CP*CO2ICO(i,zj)*IM(i,zj,z));
3452   EQ16_3(z4)..    TCBAM(z4) =e= 0;
3453   EQ16_4(z3)..    TCBAM(z3) =e= sum((i,zj), CP(zj)*CO2ICO(i,zj)*IM(i,zj,z3));
3454   
3455   EQ17(z)..       TPRODN(z) =e= TIWT(z)+TIKT(z)+TIPT(z);
3456   
3457   EQ18(z)..       TIWT(z) =e= SUM[(l,j)$LDO(l,j,z),TIW(l,j,z)];
3458   
3459   EQ19(z)..       TIKT(z) =e= SUM[(k,j)$KDO(k,j,z),TIK(k,j,z)];
3460   
3461   EQ20(z)..       TIPT(z) =e= SUM[j,TIP(j,z)];
3462   
3463   EQ21(z)..       TPRCTS(z) =e= TICT(z)+TIMT(z)+TIXT(z);
3464   
3465   EQ22(z)..       TICT(z) =e= SUM[i,TIC(i,z)];
3466   
3467   EQ23(z)..       TIMT(z) =e= SUM[(i,zj)$IMO(i,zj,z),TIM(i,zj,z)];
3468   
3469   EQ24(z)..       TIXT(z) =e= SUM[(i,zj)$EXO(i,z,zj),TIX(i,z,zj)];
3470   
3471   EQ25(z)..       TDH(z) =e= PIXCON(z)**eta*ttdh0(z)+ttdh1(z)*YH(z);
3472   
3473   EQ26(l,j,z)$LDO(l,j,z)..
3474                   TIW(l,j,z) =e= ttiw(l,j,z)*W(l,z)*LD(l,j,z);
3475   
3476   EQ27(k,j,z)$KDO(k,j,z)..
3477                   TIK(k,j,z) =e= ttik(k,j,z)*R(k,j,z)*KD(k,j,z);
3478   
3479   EQ28(j,z)..     TIP(j,z) =e= ttip(j,z)*PP(j,z)*XST(j,z);
3480   
3481   EQ29(i,z)..     TIC(i,z) =e= ttic(i,z)*{[PL(i,z)*DD(i,z)]$DDO(i,z)
3482                   +[SUM[zj$IMO(i,zj,z),(1+ttim(i,zj,z))*IM(i,zj,z)*e(z)
3483                    *(PWM(i,zj,z)+SUM(ij,PWMG(ij)*tmrg(ij,i,zj,z)))]]};
3484   
3485   EQ30(i,zj,z)$IMO(i,zj,z)..
3486                   TIM(i,zj,z) =e= ttim(i,zj,z)*IM(i,zj,z)*e(z)*(PWM(i,zj,z)
3487                                  +SUM[ij,PWMG(ij)*tmrg(ij,i,zj,z)]);
3488   
3489   EQ31(i,z,zj)$EXO(i,z,zj)..
3490                   TIX(i,z,zj) =e= ttix(i,z,zj)*PE(i,z,zj)*EX(i,z,zj);
3491   
3492   EQ32(z3)..       SG(z3) =e= YG(z3)-G(z3)-TCTAX(z3)+ TCBAM(z3);
3493   EQ32_1(z4)..     SG(z4) =e= YG(z4)-G(z4)-TCTAX(z4);
3494  *==============================================================================
3495  *    5.3.2.4 Rest of the world
3496  *==============================================================================
3497   EQ33(z)..       YROW(z) =e= e(z)*SUM{(i,zj)$IMO(i,zj,z),IM(i,zj,z)*
3498                             [PWM(i,zj,z)+SUM(ij,PWMG(ij)*tmrg(ij,i,zj,z))]};
3499   
3500   EQ34(z)..       SROW(z) =e= YROW(z)-e(z)*SUM[(i,zj)$EXO(i,z,zj),
3501                                 EX(i,z,zj)*PWX(i,z,zj)]-e(z)
3502                                 *SUM[i$MRGNO(i,z),MRGN(i,z)*PWMG(i)];
3503   
3504   EQ35(z)..       SROW(z) =e= -CAB(z);
3505   
3506  *==============================================================================
3507  *   5.3.3 Demand
3508  *==============================================================================
3509   EQ36(i,z)..     PC(i,z)*C(i,z) =e= PC(i,z)*CMIN(i,z)+gamma_LES(i,z)
3510                                   *{CTH(z)-SUM[ij,PC(ij,z)*CMIN(ij,z)]};
3511   
3512   EQ37(i,z)..     PC(i,z)*INV(i,z) =e= gamma_INV(i,z)*IT(z);
3513   
3514   EQ38(i,z)..     PC(i,z)*CG(i,z) =e= gamma_GVT(i,z)*G(z);
3515   
3516   EQ39(nene,z)..     DIT(nene,z) =e= SUM[j,DI(nene,j,z)];
3517   
3518   EQ39_1(ene,z)..   DIT(ene,z) =e= SUM[j,DE(ene,j,z)];
3519   
3520  *==============================================================================
3521  *   5.3.4 International trade
3522  *==============================================================================
       EQB_1(i,z)..    XS_I(i,z) =e= B_X3(i,z)*SUM[j$XSO(j,i,z),beta_X3(j,i,z)
                                      *XS(j,i,z)**(-rho_X3(i,z))]**(-1/rho_X3(i,z));
       
       EQB_2(j,i,z)${DSO(j,i,z) and [DSO(j,i,z) ne DSO_I(i,z)]}..
                       XS(j,i,z) =e= XS_I(i,z)/B_X3(i,z)**(1-sigma_X3(i,z))*
                                     [beta_X3(j,i,z)*PI(i,z)/P2(j,i,z)]
                                     **sigma_X3(i,z);
       
       EQB_3(j,i,z)${DSO(j,i,z)}..   P2(j,i,z) =e= PT(j,z);
       
       EQB_4(j,i,z)$DSO(j,i,z)..
                       P2(j,i,z)*XS(j,i,z) =e= [PET(i,z)*EXTT(j,i,z)]$EXTTO(j,i,z)
                                              +[e(z)*MRGN(i,z)*PWMG(i)]$MRGNO(i,z)
                                              +[PL(i,z)*DS(j,i,z)]$DSO(j,i,z);
       
       EQB_5(j,i,z)$DSO(j,i,z)..  EXTT(j,i,z)  =e= theta2(j,i,z)*EXT(i,z);
3541   
3542  *[Top Nest - Leontief function]
3543   EQA_1(z)..  XS('18_TnD','18_ELEC',z) =e= TnDShare(z)*XS_I('18_ELEC',z);
3544   EQA_2(z)..  XS_I('18_ELEC',z) =e= XS('18_TnD','18_ELEC',z) + POWERQ(z);
3545   
3546   
3547  *[Second Nest - CES function]
3548   EQA_3(z)..    POWERQ(z) =e= B_X4(z)*SUM[POWER, beta_X4(power,z)
3549                                  *XS(POWER,'18_ELEC',z)**(-rho_X4(z))]**(-1/rho_X4(z));
3550   
3551   EQA_4(power,'18_ELEC',z)..  XS(POWER,'18_ELEC',z) =e= POWERQ(z)/B_X4(z)**(1-sigma_X4(z))*
3552                                 [beta_X4(power,z)*PPOWER(z)/P2(POWER,'18_ELEC',z)]
3553                                 **sigma_X4(z);
3554   
3555  * exclude electiricity
3556   EQB_1(i2,z)..    XS_I(i2,z) =e= B_X3(i2,z)*SUM[j$XSO(j,i2,z),beta_X3(j,i2,z)
3557                                  *XS(j,i2,z)**(-rho_X3(i2,z))]**(-1/rho_X3(i2,z));
3558   
3559   
3560   EQB_3(j,i,z)${DSO(j,i,z)}..   P2(j,i,z) =e= PT(j,z);
3561   
3562   EQB_4(j,i,z)$DSO(j,i,z)..
3563                   P2(j,i,z)*XS(j,i,z) =e= [PET(i,z)*EXTT(j,i,z)]$EXTTO(j,i,z)
3564                                          +[e(z)*MRGN(i,z)*PWMG(i)]$MRGNO(i,z)
3565                                          +[PL(i,z)*DS(j,i,z)]$DSO(j,i,z);
3566   
3567   EQB_5(j,i,z)$DSO(j,i,z)..  EXTT(j,i,z)  =e= theta2(j,i,z)*EXT(i,z);
3568   
3569   EQ40_3(i,z)..   DS_I(i,z) =e= sum(j,DS(j,i,z)$DSO(j,i,z));
3570   
3571   EQ40_4(j,z)..   XST(j,z)  =e= sum(i,XS(j,i,z)$XSO(j,i,z));
3572   
3573   EQ40_5(i,z)..   XS_I(i,z) =e= B_X1(i,z)*{
3574                   [beta_EX_X1(i,z)*EXT(i,z)**rho_X1(i,z)]$EXTO(i,z)
3575                  +[beta_D_X1(i,z)*DS_I(i,z)**rho_X1(i,z)]$DSO_I(i,z)
3576                  +[(1-beta_EX_X1(i,z)-beta_D_X1(i,z))*MRGN(i,z)**rho_X1(i,z)]$MRGNO(i,z)
3577                                            }**(1/rho_X1(i,z));
3578   
3579   EQ41(i,z)$[EXTO(i,z) and DSO_I(i,z)]..
3580                   EXT(i,z) =e= {[beta_D_X1(i,z)/beta_EX_X1(i,z)]*[PET(i,z)/PL(i,z)]}
3581                                **sigma_X1(i,z)*DS_I(i,z);
3582   
3583   EQ42(i,z)$[MRGNO(i,z) and DSO_I(i,z)]..
3584                   MRGN(i,z) =e= {[beta_D_X1(i,z)/(1-beta_EX_X1(i,z)
3585                                   -beta_D_X1(i,z))]*[e(z)*PWMG(i)/PL(i,z)]}
3586                                   **sigma_X1(i,z)*DS_I(i,z);
3587   
3588   EQ43(i,z)$EXTO(i,z)..
3589                   EXT(i,z) =e= B_X2(i,z)*SUM[zj$EXO(i,z,zj),beta_X2(i,z,zj)
3590                                  *EX(i,z,zj)**rho_X2(i,z)]**(1/rho_X2(i,z));
3591   
3592   EQ44(i,z,zj)$EXO(i,z,zj)..
3593                   EX(i,z,zj) =e= EXT(i,z)/B_X2(i,z)**(1+sigma_X2(i,z))*
3594                                    [PE(i,z,zj)/(beta_X2(i,z,zj)*PET(i,z))]
3595                                    **sigma_X2(i,z);
3596   
3597   EQ45(i,z)..     Q(i,z) =e= B_M1(i,z)*{
3598                      [beta_M1(i,z)*IMT(i,z)**(-rho_M1(i,z))]$IMTO(i,z)
3599                     +[(1-beta_M1(i,z))*DD(i,z)**(-rho_M1(i,z))]$DDO(i,z)
3600                                          }**(-1/rho_M1(i,z));
3601   
3602   EQ46(i,z)$[IMTO(i,z) and DDO(i,z)]..
3603                   IMT(i,z) =e= {[beta_M1(i,z)/(1-beta_M1(i,z))]*[PD(i,z)
3604                                  /PMT(i,z)]}**sigma_m1(i,z)*DD(i,z);
3605   
3606   EQ47(i,z)$IMTO(i,z)..
3607                   IMT(i,z) =e= B_M2(i,z)*SUM[zj$IMO(i,zj,z),beta_M2(i,zj,z)*
3608                                  IM(i,zj,z)**(-rho_M2(i,z))]**(-1/rho_M2(i,z));
3609   
3610   EQ48(i,zj,z)$IMO(i,zj,z)..
3611                   IM(i,zj,z) =e= IMT(i,z)/B_M2(i,z)**(1-sigma_M2(i,z))*
3612                                    [beta_M2(i,zj,z)*PMT(i,z)/PM(i,zj,z)]
3613                                    **sigma_M2(i,z);
3614   
3615  *==============================================================================
3616  *   5.3.5 Prices
3617  *==============================================================================
3618   EQ49(j2,z)..    PP(j2,z)*XST(j2,z) =e= PKLE(j2,z)*KLE(j2,z)+PCI(j2,z)*CI(j2,z);
3619   
3620   EQ49_1(j3,z)..  PP(j3,z)*XST(j3,z) =e= PVA(j3,z)*VA(j3,z)+PCI(j3,z)*CI(j3,z)+PCE(j3,z)*CE(j3,z);
3621   
3622   EQ50(j,z)..     PT(j,z) =e= (1+ttip(j,z))*PP(j,z);
3623   
3624   EQ51(j,z)..     PCI(j,z)*CI(j,z) =e= SUM[nene,PC(nene,z)*DI(nene,j,z)];
3625   
3626   EQ51_1(j,z)..   PCE(j,z)*CE(j,z) =e= SUM[ene,PC(ene,z)*DE(ene,j,z) + PC(ene,z)*CTAX(Z)*CO2FACTOR(ene,j,z)*DE(ene,j,z)];
3627   
3628  *EQ51_1(j,z)..   PCE(j,z)*CE(j,z) =e= SUM[ene,P4(ene,j,z)*DE(ene,j,z)];
3629   
3630   EQ52(j,z)..     PVA(j,z)*VA(j,z) =e= [WC(j,z)*LDC(j,z)]$LDCO(j,z)
3631                                       +[RC(j,z)*KDC(j,z)]$KDCO(j,z);
3632   
3633   EQ52_1(j2,z)..   PKLE(j2,z)*KLE(j2,z) =e= [PVA(j2,z)*VA(j2,z)]$VAO(j2,z) + [PCE(j2,z)*CE(j2,z)]$CEO(j2,z);
3634   
3635  * Given equations 5 and 6, equation 53 is redundant
3636  * EQ53(j,z)..     WC(j,z)*LDC(j,z) =e= SUM[l$LDO(l,j,z),WTI(l,j,z)*LD(l,j,z)];
3637   
3638   EQ54(l,j,z)$LDO(l,j,z)..
3639                   WTI(l,j,z) =e= W(l,z)*(1+ttiw(l,j,z));
3640   
3641   EQ54_1(ene,j,z)$DEO(ene,j,z)..
3642                   P4(ene,j,z) =e= PC(ene,z);
3643   
3644  * Given equations 7 and 8, equation 55 is redundant
3645  * EQ55(j,z)$(kmob and KDCO(j,z))..
3646  *                 RC(j,z)*KDC(j,z) =e= SUM[k$KDO(k,j,z),RTI(k,j,z)*KD(k,j,z)];
3647   
3648   EQ56(k,j,z)$KDO(k,j,z)..
3649                   RTI(k,j,z) =e= R(k,j,z)*(1+ttik(k,j,z));
3650   
3651   EQ57(k,j,z)$(kmob and KDO(k,j,z))..
3652                   R(k,j,z) =e= RK(k,z);
3653   
3654  * EQ58(j,z)..     P(j,z)*XST(j,z) =e= [PL(j,z)*DS(j,z)]$DSO(j,z)
3655  *                                   +[PET(j,z)*EXT(j,z)]$EXTO(j,z)
3656  *                                   +[e(z)*PWMG(j)*MRGN(j,z)]$MRGNO(j,z);
3657   
3658   EQ58(i,z)..     P(i,z)*XS_I(i,z) =e= [PL(i,z)*DS_I(i,z)]$DSO_I(i,z)
3659                                       +[PET(i,z)*EXT(i,z)]$EXTO(i,z)
3660                                       +[e(z)*PWMG(i)*MRGN(i,z)]$MRGNO(i,z);
3661   
3662  * Given equations 43 and 44, equation 59 is redundant
3663  * EQ59(i,z)$EXTO(i,z)..
3664  *                 PET(i,z)*EXT(i,z) =e= SUM[zj$EXO(i,z,zj),
3665  *                                           PE(i,z,zj)*EX(i,z,zj);
3666   
3667   EQ60(i,z,zj)$EXO(i,z,zj)..
3668                   PE(i,z,zj)*(1+ttix(i,z,zj)) =e= e(z)*PWX(i,z,zj);
3669   
3670   EQ61(i,z)$DDO(i,z)..
3671                   PD(i,z) =e= (1+ttic(i,z))*PL(i,z);
3672   
3673   EQ62(i,zj,z)$IMO(i,zj,z)..
3674                   PM(i,zj,z) =e= (1+ttic(i,z))*(1+ttim(i,zj,z))*(1+CP(zj)*CO2ICO(i,zj))*e(z)*
3675                                    (PWM(i,zj,z)+SUM[ij,PWMG(ij)
3676                                    *tmrg(ij,i,zj,z)]);
3677   
3678  * Given equations 47 and 48, equation 63 is redundant
3679  * EQ63(i,z)$IMTO(i,z)..
3680  *                 PMT(i,z)*IMT(i,z) =e= SUM[zj$IMO(i,zj,z),
3681  *                                           PM(i,zj,z)*IM(i,zj,z);
3682   
3683   EQ64(i,z)..     PC(i,z)*Q(i,z) =e= [PD(i,z)*DD(i,z)]$DDO(i,z)+
3684                                      [PMT(i,z)*IMT(i,z)]$IMTO(i,z);
3685   
3686   EQ65(z)..       PK(z) =e= 1/A_K(z)*PROD[i$gamma_INV(i,z),(PC(i,z)
3687                                 /gamma_INV(i,z))**gamma_INV(i,z)];
3688   
3689   EQ66(z)..       PIXGDP(z) =e=
3690                   {SUM[j,{(PVA(j,z)*VA(j,z)+TIP(j,z))/VA(j,z)}*VAO(j,z)]
3691                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
3692                   *SUM[j,{(PVA(j,z)*VA(j,z)+TIP(j,z))/VA(j,z)}*VA(j,z)]
3693                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VA(j,z)]}**0.5;
3694   
3695   EQ67..          PIXGDP_W =e=
3696                   {SUM[(j,z),{(PVA(j,z)*VA(j,z)+TIP(j,z))/VA(j,z)}*VAO(j,z)/e(z)]
3697                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
3698                   *SUM[(j,z),{(PVA(j,z)*VA(j,z)+TIP(j,z))/VA(j,z)}*VA(j,z)/e(z)]
3699                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VA(j,z)/eO(z)]}**0.5;
3700   
3701   EQ68(z)..       PIXCON(z) =e= SUM[i,PC(i,z)*CO(i,z)]/SUM[i,PCO(i,z)*CO(i,z)];
3702   
3703   EQ69(z)..       PIXINV(z) =e= PROD[i$gamma_INV(i,z),(PC(i,z)/PCO(i,z))
3704                                   **gamma_INV(i,z)];
3705   
3706   EQ70(z)..       PIXGVT(z) =e= PROD[i$gamma_GVT(i,z),(PC(i,z)/PCO(i,z))
3707                                   **gamma_GVT(i,z)];
3708   
3709  *==============================================================================
3710  *   5.3.6 Equilibrium
3711  *==============================================================================
3712   EQ71(i1,z)..    Q(i1,z) =e= C(i1,z)+CG(i1,z)+INV(i1,z)+DIT(i1,z);
3713   
3714   EQ72(l,z)..     LS(l,z) =e= SUM[j$LDO(l,j,z),LD(l,j,z)];
3715   
3716   EQ73(k,z)$KSO(k,z)..
3717                   KS(k,z) =e= SUM[j$KDO(k,j,z),KD(k,j,z)];
3718   
3719   EQ74(z)..       IT(z) =e= SH(z)+SG(z)-CAB(z);
3720   
3721   EQ75(z)..       DEP(z) =e= PK(z)*delta(z)*SUM[k$KSO(k,z),KS(k,z)];
3722   
3723   EQ76(i,z)$DDO(i,z)..
3724                   SUM[j$DSO(j,i,z),DS(j,i,z)] =e= DD(i,z);
3725   
3726   EQ77(i,z,zj)$EXO(i,z,zj)..
3727                   EX(i,z,zj) =e= IM(i,z,zj);
3728   
