 423  *==============================================================================
 424  * 2 Declaration of parameters and benchmark variables
 425  *==============================================================================
 426  PARAMETER
 427  *==============================================================================
 428  *  2.1 Parameters
 429  *==============================================================================
 430   A_K(z)               Scale parameter (price of new capital)
 431   aij(i,j,z)           Input output coefficient
 432   aij2(i,j,z)          Input output coefficient (intermediate energy)
 433   B_KD(j,z)            Scale parameter (CES - composite capital)
 434   B_LD(j,z)            Scale parameter (CES - composite labor)
 435   B_M1(i,z)            Scale parameter (CES - composite commodity)
 436   B_M2(i,z)            Scale parameter (CES - composite import)
 437   B_VA(j,z)            Scale parameter (CES - value added)
 438   B_KLE(j,z)           Scale parameter (CES - composite KLE)
 439   B_ENER(j,z)          Scale parameter (CES - composite ENER)
 440   B_X1(i,z)            Scale parameter (CET - total output)
 441   B_X2(i,z)            Scale parameter (CET - composite export)
 442   B_X3(i,z)            Scale parameter (CES - top level)
 443   B_X4(z)              Scale parameter (CES - Aggregated Electricity)
 444   beta_D_X1(i,z)       Share parameter (CET - total output - local sales)
 445   beta_EX_X1(i,z)      Share parameter (CET - total output - export)
 446   beta_X2(i,z,zj)      Share parameter (CET - composite export)
 447   beta_X3(j,i,z)       Share parameter (CES - top level)
 448   beta_X4(power, z)    Share parameter (CES - Aggregated Electricity)
 449   beta_KD(k,j,z)       Share parameter (CES - composite capital)
 450   beta_LD(l,j,z)       Share parameter (CES - composite labor)
 451   beta_M1(i,z)         Share parameter (CES - composite commodity)
 452   beta_M2(i,zj,z)      Share parameter (CES - composite import)
 453   beta_VA(j,z)         Share parameter (CES - value added)
 454   beta_KLE(j,z)        Share parameter (CES - KLE composite)
 455   beta_ENER(ene,j,z)   Share parameter (CES - ENER composite)
 456   delta(z)             Depreciation rate of capital in country z
 457   eta                  Price elasticity of indexed transfers and parameters
 458   frisch(z)            Frisch parameter (LES function)
 459   gamma_GVT(i,z)       Share of commodity i in total current public expenditures on goods and services
 460   gamma_INV(i,z)       Share of commodity i in total investment expenditures
 461   gamma_LES(i,z)       Marginal share of commodity i in household consumption budget
 462   io(j,z)              Coefficient (Leontief - intermediate consumption)
 463   io2(j,z)             Coefficient (Leontief - intermediate energy consumption)
 464   v(j,z)               value added Coefficient (Leontief)
 465   v2(j,z)              KLE Share parameter (Leontief)
 466   kmob                 Flag parameter (1 if capital is mobile)
 467   RES                  Rescaling factor
 468   rho_KD(j,z)          Elasticity paameter (CES - composite capital)
 469   rho_LD(j,z)          Elasticity parameter (CES - composite labor)
 470   rho_M1(i,z)          Elasticity parameter (CES - composite commodity)
 471   rho_M2(i,z)          Elasticity parameter (CES - composite import)
 472   rho_VA(j,z)          Elasticity parameter (CES - value added)
 473   rho_KLE(j,z)         Elasticity parameter (CES - KLE)
 474   rho_ENER(j,z)        Elasticity parameter (CES - ENER)
 475   rho_X1(i,z)          Elasticity parameter (CET - composite export)
 476   rho_X2(i,z)          Elasticity parameter (CET - composite export)
 477   rho_X3(i,z)          Elasticity parameter (CES - top level)
 478   rho_X4(z)            Elasticity parameter (CES - Aggregated Electricity)
 479   sigma_KD(j,z)        Elasticity (CES - composite capital)
 480   sigma_LD(j,z)        Elasticity (CES - composite labor)
 481   sigma_M1(i,z)        Elasticity (CES - composite commodity)
 482   sigma_M2(i,z)        Elasticity (CES - composite import)
 483   sigma_VA(j,z)        Elasticity (CES - value added)
 484   sigma_KLE(j,z)       Elasticity (CES - kle)
 485   sigma_ENER(j,z)      Elasticity (CES - within energy)
 486   sigma_X0(j,z)        Elasticity (CET - exports and local sales)
 487   sigma_X1(i,z)        Elasticity (CET - total output)
 488   sigma_X2(i,z)        Elasticity (CET - composite export)
 489   sigma_X3(i,z)        Elasticity (CES - top level)
 490   sigma_X4(z)          Elasticity (CES - Aggregated Electricity)
 491   sigma_Y(i,z)         Income elasticity of consumption
 492   tmrg(i,ij,zj,z)      Rate of margin i applied to commodity ij imported from country zj
 493   TnDShare(z)          T&D share of Aggregated electricity
 494   PowerShare(z)        Power Industries share of Aggregated electricity
 495   theta2(j,i,z)        Export share of composite activity
 496   
 497  *==============================================================================
 498  *  2.2 Variables - Benchmark
 499  *==============================================================================
 500  *  Benchmark values of variables are parameters. Their acronyms are the
 501  *  corresponding variable names,followed by the letter "O".
 502   
 503  *==============================================================================
 504  *   2.2.1 Volume variables
 505  *==============================================================================
 506   CABXO(z)        Current account balance of region z in terms of the international currency (pseudo-volume variable)
 507   CO(i,z)         Consumption of commodity i by households in region z
 508   CGO(i,z)        Public consumption of commodity i in region z
 509   CIO(j,z)        Total intermediate consumption of industry j in region z
 510   CEO(j,z)        Total energy intermediate consumption of industry j in region z
 511   CMINO(i,z)      Minimum consumption of commodity i by households in region z
 512   CTH_REALO(z)    Real household consumption in region z
 513   DDO(i,z)        Domestic demand for commodity i produced locally in region z
 514   DIO(i,j,z)      Intermediate consumption of commodity i by industry j in region z
 515   DEO(ene,j,z)    Intermediate energy consumption of commodity i by industry j in region z
 516   DITO(i,z)       Total intermediate demand of commodity i in region z
 517   DSO(j,i,z)      Supply of commodity i by sector j to the domestic market
 518   DSO_I(i,z)      Supply of commodity i to the domestic market of region z
 519   DSO_J(j,z)      Supply of activity j to the domestic market of region z
 520   EXO(i,z,zj)     Quantity of product i exported by country z to country zj
 521   EXTO(i,z)       Supply of composite commodity i by region z to the export market
 522   EXTTO(j,i,z)    Supply of activity j to the export market i of region z
 523   G_REALO(z)      Current real government expenditures on goods and services in region z
 524   GDP_BP_REALO(z) Real GDP at basic prices
 525   GDP_MP_REALO(z) Real GDP at market prices
 526   GDP_BP_W_REALO  Real GDP at basic prices
 527   IMO(i,zj,z)     Quantity of product i imported by country z from country zj
 528   IMTO(i,z)       Quantity demanded of composite imports of commodity i by region z
 529   INVO(i,z)       Final demand of commodity i for investment purposes (GFCF) in region z
 530   IT_REALO(z)     Real gross fixed capital formation
 531   KDO(k,j,z)      Demand for type k capital by industry j in region z
 532   KDCO(j,z)       Demand for composite capital by industry j in region z
 533   KSO(k,z)        Supply of type k capital in region z
 534   KSTO(z)         Total supply of capital in region z
 535   LDO(l,j,z)      Demand for type l labor by industry j in region z
 536   LDCO(j,z)       Demand for composite labor by industry j in region z
 537   LSO(l,z)        Supply of type l labor in region z
 538   MRGNO(i,z)      Domestic production of commodity i in region z exported as international margin services
 539   POPO(z)         Population in 2019
 540   QO(i,z)         Quantity demanded of composite commodity i in region z
 541   VAO(j,z)        Value added of industry j in region z
 542   KLEO(j,z)       KLE of industry j in region z
 543   XSO_I(i,z)      Commoidty i total production
 544   XSO(j,i,z)      Total output of industry j in region z
 545   XSTO(j,z)       Total output of industry j
 546   POWERQO(z)      Total power output in region z
 547   
 548  *==============================================================================
 549  *   2.2.2 Price variables
 550  *==============================================================================
 551   eO(z)           Exchange rate (price of international currency in terms of region z local currency)
 552   PO(i,z)         Basic price of commodity i in region z
 553   PO2(j,i,z)      Basic price of industry js production of commodity i
 554   PO3(i,j,z)
 555   PO4(i,j,z)
 556   PPOWERO(z)
 557   PIO(i,z)
 558   PTO(j,z)        Basic price of industry js output
 559   PCO(i,z)        Purchaser price of composite commodity i (including all taxes and margins) in region z
 560   PCIO(j,z)       Intermediate consumption price index of industry j in region z
 561   PCEO(j,z)       Intermediate energy consumption price index of industry j in region z
 562   PDO(i,z)        Price of local product i sold on region z domestic market (including all taxes)
 563   PEO(i,z,zj)     Price received for commodity i exported to region zj by region z (excluding export taxes)
 564   PETO(i,z)       Border price of composite commodity i exported by region z
 565   PIXCONO(z)      Consumer price index in region z
 566   PIXGDPO(z)      GDP deflator in region z
 567   PIXGDP_WO       World GDP deflator
 568   PIXGVTO(z)      Public expenditures price index in region z
 569   PIXINVO(z)      Investment price index in region z
 570   PKO(z)          Price of new capital in region z
 571   PLO(i,z)        Price of local product i (excluding all taxes on products) in region z
 572   PMO(i,zj,z)     Price of commodity i imported by region z from region zj (including all taxes duties and margins)
 573   PMTO(i,z)       Price of composite commodity i imported by region z (including all taxes duties and margins)
 574   PPO(j,z)        Unit cost of industry j in region z including taxes directly related to the use of capital and labor but excluding other taxes on production
 575   PVAO(j,Z)       Price of industry j value added in region z (including taxes on production directly related to the use of capital and labor)
 576   PKLEO(j,z)      Price of industry j KLE in region z
 577   PWMO(i,zj,z)    World price of commodity i imported from country zj by region z (expressed in international currency)
 578   PWMGO(i)        World price of margin i (expressed in international currency)
 579   PWXO(i,z,zj)    World price of commodity i exported to country zj by region z (expressed in international currency)
 580   RO(k,j,z)       Rental rate of type k capital in industry j of region z
 581   RCO(j,z)        Rental rate of industry j composite capital in region z
 582   RKO(k,z)        Rental rate of type k capital in region z
 583   RTIO(k,j,z)     Rental rate paid by industry j for type k capital in region z including capital taxes
 584   WO(l,z)         Wage rate of type l labor in region z
 585   WCO(j,z)        Wage rate of industry j composite labor in region z
 586   WTIO(l,j,z)     Wage rate paid z by industry j for type l labor in region including payroll taxes
 587   
 588   
 589   
 590  *==============================================================================
 591  *   2.2.3 Nominal (value) variables
 592  *==============================================================================
 593   CABO(z)         Current account balance of region z
 594   CTHO(z)         Consumption budget of households in region z
 595   DEPO(z)         Amount of depreciation (capital consumption allowance) in region z
 596   GO(z)           Current government expenditures on goods and services in region z
 597   GDP_BPO(z)      Region z GDP at basic prices
 598   GDP_BP_WO       World GDP at basic prices
 599   GDP_FDO(z)      Region z GDP at purchasers prices from the perspective of final demand
 600   GDP_IBO(z)      Region z GDP at market prices (income-based)
 601   GDP_MPO(z)      Region z GDP at market prices
 602   ITO(z)          Total investment expenditures in region z
 603   RKDO(k,j,z)     Type k capital income in industry j in region z
 604   SGO(z)          Government savings in region z
 605   SHO(z)          Household savings in region z
 606   SROWO(z)        Rest-of-the-world savings with respect to region z
 607   TDHO(z)         Household income taxes in region z
 608   TICO(i,z)       Government revenue from indirect taxes on commodity i in region z
 609   TICTO(z)        Total government receipts of indirect taxes on commodities in region z
 610   TIKO(k,j,z)     Government revenue from taxes on type k capital used by industry j in region z
 611   TIKTO(z)        Total government revenue from from taxes on capital in region z
 612   TIMO(i,zj,z)    Government revenue from duties on commodity i imported from region zj by region z
 613   TIMTO(z)        Total government revenue from import duties in region z
 614   TIPO(j,z)       Government revenue from taxes on industry j production in region z (excluding taxes directly related to the use of capital and labor)
 615   TIPTO(z)        Total government revenue from production taxes in region z (excluding taxes directly related to the use of capital and labor)
 616   TIWO(l,j,z)     Government revenue from payroll taxes on type l labor in industry j of region z
 617   TIWTO(z)        Total government revenue from payroll taxes in region z
 618   TIXO(i,z,zj)    Government revenue from export taxes on commodity i exported by region z to region zj
 619   TIXTO(z)        Total government revenue from export taxes in region z
 620   TPRCTSO(z)      Total government revenue from taxes on products and imports in region z
 621   TPRODNO(z)      Total government revenue from other taxes on production in region z
 622   YDHO(z)         Household disposable income in region z
 623   YGO(z)          Total government income in region z
 624   YHO(z)          Household total income in region z
 625   YHKO(z)         Household capital income in region z
 626   YHLO(z)         Household labor income in region z
 627   YROWO(z)        Rest-of-the-world total income from region z
 628   
 629  *==============================================================================
 630  *   2.2.4 Rates and intercepts
 631  *==============================================================================
 632   sh0O(z)         Intercept (household savings)
 633   sh1O(z)         Slope (household savings)
 634   ttdh0O(z)       Intercept (household income tax)
 635   ttdh1O(z)       Slope (household income tax)
 636   tticO(i,z)      Tax rate on commodity i
 637   ttikO(k,j,z)    Tax rate on capital k used in industry j
 638   ttimO(i,zj,z)   Rate of taxes and duties on imports of commodity i from country zj
 639   ttipO(j,z)      Tax rate on the production of industry j
 640   ttiwO(l,j,z)    Tax rate on type l worker compensation in industry j
 641   ttixO(i,z,zj)   Export tax rate on exported commodity i
 642   
 643  ;
 644   
 645  Scalar
 646   Tiny small figure / 0.000000000001/ ;
 647   
 648  *==============================================================================
 649  * 3 Data
 650  *==============================================================================
 651  *  3.1 Data input from GTAP8.1
 652  *==============================================================================
 653  *   3.1.1 Reading data aggregated with DATA_AGG-2007.gms
 654  *==============================================================================
 655  *  The PEP w-1 model uses aggregated data from GTAP8.1. The following file
 656  *  includes data for some variables and substitution elasticities.
 657  *$GDXIN Input_w-1\DATA_AGG-2019_GTAP11_240214.gdx
GDXIN   C:\Users\kimc0\GUIDE_GLOBAL_CGE\1.Static_CGE\Output_w-1\DATA_AGG-2019_GTAP11_240214.gdx
 659   
--- LOAD  CO = 14:CO
--- LOAD  CGO = 15:CGO
--- LOAD  DDO = 16:DDO
--- LOAD  DEPO = 17:DEPO
--- LOAD  DIO = 18:DIO
--- LOAD  DSO = 19:DSO
--- LOAD  DSO_I = 20:DSO_I
--- LOAD  EXO = 21:EXO
--- LOAD  IMO = 22:IMO
--- LOAD  INVO = 23:INVO
--- LOAD  KSTO = 24:KSTO
--- LOAD  LDO = 25:LDO
--- LOAD  MRGNO = 26:MRGNO
--- LOAD  XSO = 40:XSO
--- LOAD  XSO_I = 41:XSO_I
--- LOAD  XSTO = 42:XSTO
--- LOAD  RKDO = 28:RKDO
--- LOAD  POPO = 27:POPO
--- LOAD  TDHO = 29:TDHO
--- LOAD  TICO = 31:TICO
--- LOAD  TIKO = 32:TIKO
--- LOAD  TIMO = 33:TIMO
--- LOAD  TIPO = 34:TIPO
--- LOAD  TIWO = 35:TIWO
--- LOAD  TIXO = 36:TIXO
--- LOAD  tmrg = 39:tmrg
--- LOAD  sigma_M1 = 44:sigma_M1
--- LOAD  sigma_M2 = 45:sigma_M2
--- LOAD  sigma_VA = 46:sigma_VA
 663   
 664   
 665  display sigma_M1, sigma_M2 ;
 666   
 667  sigma_M1('04_GAS',Z) = 6;
 668  sigma_M2('03_OIL',Z) = 6;
 669  sigma_M2('04_GAS',Z) = 6;
 670   
 671  display sigma_M1, sigma_M2 ;
 672  *$exit
 673  *==============================================================================
 674  *   3.1.2 Rescaling the variables
 675  *==============================================================================
 676  * GTAP 8.1 data are in millions of (2004 and 2007) US dollars
 677  * (see www.gtap.agecon.purdue.edu/resources/download/5679.pdf)
 678  * With RES = 10000, model results are in tens of billions (10G$)
 679  RES              = 10000;
 680  *RES = 1;
 681  * NOTE: In GTAP parlance, "agents' prices" are prices paid by buyers, and
 682  *       "market prices" are prices received by sellers.
 683   
 684  * Household consumption = GTAP domestic purchases (VDPA) + import purchases (VIPA)
 685  * by households at agents' prices.
 686  CO(i,z)          = CO(i,z)/RES;
 687   
 688  * Public final consumption = domestic purchases (VDGA) + import purchases (VIGA)
 689  * by government at agents' prices.
 690  CGO(i,z)         = CGO(i,z)/RES;
 691   
 692  * Domestic purchases = domestic absorption:
 693  * (CO + CGO + INVO + DIO) - [ imports (IMO) + transport margins (tmrg)
 694  *                              + indirect taxes (TICO + TIMO) ]
 695  DDO(i,z)         = DDO(i,z)/RES;
 696   
 697  * Capital depreciation (DEP)
 698  DEPO(z)          = DEPO(z)/RES;
 699   
 700  * Intermediate consumption = domestic purchases (VDFA) + import purchases (VIFA)
 701  * by firms belonging to sectors other than CGDS, at agents' prices.
 702  DIO(i,j,z)       = DIO(i,j,z)/RES;
 703   
 704  * Domestic supply = domestic demand (DDO) in GTAP_AGG.gms
 705  DSO(j,i,z)        = DSO(j,i,z)/RES;
 706  DSO_I(i,z)        = DSO_I(i,z)/RES;
 707   
 708  * Exports = exports at world prices (VXWD) = imports at world prices
 709  * Note: the GTAP variable VXWD is NOT used in the DATA_AGG.gms program; the
 710  * value recorded in DATA_AGG.gdx is actually identical to IMO
 711  EXO(i,z,zj)      = EXO(i,z,zj)/RES;
 712   
 713  * Imports = imports at world prices (VIWS) - sum of transport margins on imports (VTWR)
 714  IMO(i,z,zj)      = IMO(i,z,zj)/RES;
 715   
 716  * Demand for investment purposes = domestic purchases (VDFA)+ import purchases (VIFA)
 717  * by firms of the CGDS sector at agents' prices.
 718  INVO(i,z)        = INVO(i,z)/RES;
 719   
 720  * Total capital stock at the beginning of the period (VKB)
 721  KSTO(z)          = KSTO(z)/RES;
 722   
 723  * Labor demand = Remuneration of labor at market prices, before taxes
 724  * (components of VFM, "primary factor purchases, by households, at market prices")
 725  LDO(l,j,z)       = LDO(l,j,z)/RES;
 726   
 727  * Supply of transport margins at market prices (VST), adjusted proportionately
 728  * so that MRGNO = sum of tmrg for every margin commodity
 729  MRGNO(i,z)       = MRGNO(i,z)/RES;
 730   
 731  * Remuneration of capital at market prices, before taxes
 732  * (components of VFM, "primary factor purchases, by households, at market prices")
 733  RKDO(k,j,z)      = RKDO(k,j,z)/RES;
 734   
 735  * Direct taxes = factor payment at market prices (VFM)
 736  *                - primary factor sales at agents' prices (EVOA)
 737  TDHO(z)          = TDHO(z)/RES;
 738   
 739  * Domestic taxes on commodities = demand at agents' prices - demand at market prices:
 740  * Include 6 pairs of GTAP components
 741  *       VDPA - VDPM
 742  *       VIPA - VIPM
 743  *       VDGA - VDGM
 744  *       VIGA - VIGM
 745  *       VDFA - VDFM
 746  *       VIFA - VIFM
 747  TICO(i,z)        = TICO(i,z)/RES;
 748   
 749  * Net taxes on factor of production = factor employment tax revenue (FTRV)
 750  *                                     - factor-based subsidies (FBEP).
 751  TIKO(k,j,z)      = TIKO(k,j,z)/RES;
 752   
 753  * Import duties = "ordinary" import duties (TFRV)
 754  TIMO(i,z,zj)     = TIMO(i,z,zj)/RES;
 755   
 756  * Taxes on production = MINUS "ordinary output subsidies" (OSEP)
 757  TIPO(j,z)        = TIPO(j,z)/RES;
 758   
 759  * Net taxes on factor of production = factor employment tax revenue (FTRV)
 760  *                                     - factor-based subsidies (FBEP).
 761  TIWO(l,j,z)      = TIWO(l,j,z)/RES;
 762   
 763  * Taxes on exports = export tax equivalent of the Multi-Fiber Agreement (MFA)
 764  * quota premium(MFRV) + "ordinary" export taxes (XTRV)
 765  TIXO(i,z,zj)     = TIXO(i,z,zj)/RES;
 766   
 767  * Transport margins at world prices = sum of margins on imports (VTWR)
 768  tmrg(i,ij,z,zj)  = tmrg(i,ij,z,zj)/RES;
 769   
 770  * Domestic output = domestic supply (DSO) + supply of transport margins (MRGNO)
 771  *                   + exports (EXO) - taxes on exports (TIXO)
 772   
 773  XSO_I(i,z)        = XSO_I(i,z)/RES;
 774  XSO(j,i,z)        = XSO(j,i,z)/RES;
 775  XSTO(j,z)         = XSTO(j,z)/RES;
 776   
 777  *==============================================================================
 778  *  3.3 Exogenous prices and parameters
 779  *==============================================================================
 780   
 781  *  Price elasticity (should be equal to one to verify homogeneity)
 782  eta = 1;
 783   
 784  *==============================================================================
 785  * CES and CET elasticities
 786  *==============================================================================
 787  * CES elasticities are defined using GTAP8.1 data for imports
 788  * (sigma_M1 and sigma_M2) and value added (sigma_VA)
 789   
 790  * Other exogenous parameters can be defined if the Excel file VAL_PAR.XLS
 791  PARAMETER
 792  PARZ;
 793   
 794  *$CALL gdxxrw Input_w-1\JointB_VAL_230411_PAR.xls @Input_w-1\JointB_POWER_PAR.txt trace=0 output=Input_w-1\JointB_VAL_230411_PAR.gdx
 795   
 796  *$CALL gdxxrw JointB_VAL_230411_PAR.xls @Input_w-1\JointB_POWER_PAR.txt trace=0 output=Input_w-1\JointB_VAL_230411_PAR.gdx
 797  *$GDXIN Input_w-1\JointB_VAL_230411_PAR.gdx
GDXIN   C:\Users\kimc0\GUIDE_GLOBAL_CGE\1.Static_CGE\Output_w-1\JointB_VAL_230411_PAR.gdx
 799   
--- LOAD  sigma_KD = 1:sigma_KD
--- LOAD  sigma_LD = 2:sigma_LD
--- LOAD  sigma_KLE = 3:sigma_KLE
--- LOAD  sigma_X1 = 4:sigma_X1
--- LOAD  sigma_X2 = 5:sigma_X2
--- LOAD  sigma_X3 = 6:sigma_X3
--- LOAD  sigma_X0 = 7:sigma_X0
--- LOAD  sigma_Y = 8:sigma_y
--- LOAD  PARZ = 9:PARZ
 801   
 802  *$exit
 803  *------------------------------------------------------------------------------
 804  * CES - composite capital
 805  * We assume that the elasticity between the different type of capital
 806  * is twice that used for value added.
 807  * If the user wishes to assume otherwise, he can fill the appropriate area in
 808  * the Excel file VAL_PAR.xls and delete following line:
 809   sigma_KD(j,z)   = 2*sigma_VA(j,z);
 810  * sigma_KD(j,z)   = 0.5;
 811   sigma_KD('02_COAL','09_WEU')   = 0.5;
 812  *------------------------------------------------------------------------------
 813  * CES - composite labor
 814  * We assume that the elasticity between the different type of labor
 815  * is twice that used for value added.
 816  * If the user wishes to assume otherwise, he can fill the appropriate area in
 817  * the Excel file VAL_PAR.xls and delete following line:
 818   sigma_LD(j,z)   = 2*sigma_VA(j,z);
 819  * sigma_LD(j,z)   = 0.5;
 820  *------------------------------------------------------------------------------
 821  * CES - composite KLE, KE, ENER
 822  * sigma_KLE(j,z)  = 0.1 ;
 823   sigma_ENER(j,z) = 0.9 ;
 824   
 825  *------------------------------------------------------------------------------
 826  * CET - total output
 827  * We arbitrarily assume that the transformation elasticity between total exports,
 828  * domestic supply and margins is equal to 2 for all sectors and all region.
 829  * If the user wishes to assume otherwise, he can fill the appropriate area in
 830  * the Excel file VAL_PAR.xls.
 831   
 832  *------------------------------------------------------------------------------
 833  * CET - exports
 834  * We arbitrarily assume that the transformation elasticity between exports
 835  * to the different partners is equal to 3 for all sectors and all region.
 836  * If the user wishes to assume otherwise, he can fill the appropriate area in
 837  * the Excel file VAL_PAR.xls.
 838   
 839  *------------------------------------------------------------------------------
 840  * LES parameters - Frisch
 841  * We assume that the Frisch parameter is -1.1 for rich regions/countries and
 842  * -1.5 for other regions/countries.
 843   frisch(zrich)   = -1.1;
 844   frisch(zother)  = -1.5;
 845   
 846  * If the user wishes to assume otherwise, he can fill the appropriate area in
 847  * the Excel file VAL_PAR.xls, delete the previous 2 lines and uncomment the
 848  * following line:
 849   frisch(z)      = PARZ(z,'frisch');
 850   
 851  *------------------------------------------------------------------------------
 852  * LES parameters - Income elasticity of consumption
 853  * We arbitrarily assume that the income elasticity between is the same for all
 854  * region/country.
 855  * If the user wishes to assume otherwise, he can fill the appropriate area in
 856  * the Excel file VAL_PAR.xls.
 857   
 858  *------------------------------------------------------------------------------
 859  *  Slopes of taxation functions
 860  *   One can either choose to assign a value to the intercept and calibrate
 861  *   the slopes accordingly, or the other way around. This type of modelling
 862  *   can be useful to take into account known marginal savings or taxation rates
 863  *   or to deal with negative average saving rates in cases where savings are
 864  *   negative for some household groups.
 865  *   When no further information is available, one can simply set the intercepts
 866  *   to zero and calibrate an average rate: this is what we do here for ttdh0O.
 867  *   If the user wishes to assume otherwise, he can fill the appropriate area in
 868  *   the Excel file VAL_PAR.xls.
 869  * ttdh0O(z)       = PARZ(z,'ttdh0O');
 870   
 871   ttdh0O(z)       = 0;
 872  *   The slope ttdh1O is calibrated below in the mane GAMS file
 873   
 874  *------------------------------------------------------------------------------
 875  *  Elasticity - Investment demand function
 876  * We arbitrarily assume that this elasticity is equal to 2 for all types of
 877  * capital, all sectors and all regions.
 878  * If the user wishes to assume otherwise, he can fill the appropriate area in
 879  * the Excel file VAL_PAR.xls.
 880   
 881  *------------------------------------------------------------------------------
 882  * Also we need to assign values to some prices
 883  * All of the prices below, EXCEPT eO, may be set at arbitrary values
 884  * without loss of generality.
 885  *
 886  * In the case of eO, although exchange rates may be given arbitrary values
 887  * in the model, they must all be equal for calibration at this stage. The reason
 888  * is that the supply of margin transport services MRGNO must equal global demand.
 889  * Since there is a single world price for international transport margins
 890  * (rather than bilateral world prices for other commodities) the unit of
 891  * measurement of the volume of margin services must be the same for all regions,
 892  * and in turn, that implies that the divisor that converts the nominal value to
 893  * volume be the same for all regions. Since that divisor involves the exchange
 894  * rate, all exchange rates must be equal.
 895   
 896  * Normally, prices that may be given arbitrary values are set at 1:
 897   eO(z)           = 1;
 898   PEO(i,z,zj)     = 1;
 899   PLO(i,z)        = 1;
 900   PWMGO(i)        = 1;
 901   WO(l,z)         = 1;
 902   
 903  *==============================================================================
 904  * 4 Calibration
 905  *==============================================================================
 906  *  4.1 Calculation of income and savings related variables and parameters
 907  *==============================================================================
 908   YHKO(z)         = SUM[(k,j),RKDO(k,j,z)];
 909   YHLO(z)         = SUM[(l,j),LDO(l,j,z)];
 910   YHO(z)          = YHLO(z)+YHKO(z);
 911   YDHO(z)         = YHO(z)-TDHO(z);
 912   CTHO(z)         = SUM[i,CO(i,z)];
 913   SHO(z)          = YDHO(z)-CTHO(z);
 914   
 915   TICTO(z)        = SUM[i,TICO(i,z)];
 916   TIMTO(z)        = SUM[(i,zj),TIMO(i,zj,z)];
 917   TIWTO(z)        = SUM[(l,j),TIWO(l,j,z)];
 918   TIKTO(z)        = SUM[(k,j),TIKO(k,j,z)];
 919   TIPTO(z)        = SUM[j,TIPO(j,z)];
 920   TIXTO(z)        = SUM[(i,zj),TIXO(i,z,zj)];
 921   TPRODNO(z)      = TIKTO(z)+TIWTO(z)+TIPTO(z);
 922   TPRCTSO(z)      = TICTO(z)+TIMTO(z)+TIXTO(z);
 923   YGO(z)          = TDHO(z)+TPRCTSO(z)+TPRODNO(z);
 924   GO(z)           = SUM[i,CGO(i,z)];
 925   SGO(z)          = YGO(z)-GO(z);
 926   
 927   YROWO(z)        = SUM[(i,zj),IMO(i,zj,z)]+SUM[(i,ij,zj),tmrg(i,ij,zj,z)];
 928   SROWO(z)        = YROWO(z)-SUM[(i,zj),EXO(i,z,zj)]-SUM[i,MRGNO(i,z)];
 929   CABO(z)         = -SROWO(z);
 930   
 931   ITO(z)          = SHO(z)+SGO(z)+SROWO(z);
 932   
 933  *==============================================================================
 934  *  4.2 Calibration of parameters and other variables
 935  *==============================================================================
 936  *  4.2.1 Calibration of investment and government spending shares
 937  *==============================================================================
 938   gamma_GVT(i,z)  = CGO(i,z)/SUM[ij,CGO(ij,z)];
 939   gamma_INV(i,z)  = INVO(i,z)/SUM[ij,INVO(ij,z)] ;
 940   
 941  *==============================================================================
 942  *  4.2.2 Calibration of other prices and revised volumes (part 1)
 943  *==============================================================================
 944   LDO(l,j,z)      = LDO(l,j,z)/WO(l,z);
 945   LDCO(j,z)       = SUM[l,LDO(l,j,z)];
 946   LSO(l,z)        = SUM[j,LDO(l,j,z)];
 947   EXO(i,z,zj)     = [EXO(i,z,zj)-TIXO(i,z,zj)]/PEO(i,z,zj);
 948   EXTO(i,z)       = SUM[zj,EXO(i,z,zj)];
 949   
 950   PWXO(i,z,zj)$EXO(i,z,zj)
 951                   = {[PEO(i,z,zj)*EXO(i,z,zj)+TIXO(i,z,zj)]/EXO(i,z,zj)}/eO(z);
 952   
 953   PETO(i,z)       = SUM[zj,PEO(i,z,zj)*EXO(i,z,zj)]/EXTO(i,z);
 954   PWMO(i,z,zj)    = PWXO(i,z,zj);
 955   IMO(i,zj,z)     = EXO(i,zj,z);
 956   IMTO(i,z)       = SUM[zj,IMO(i,zj,z)];
 957   
 958   DSO(j,i,z)       = DSO(j,i,z)/PLO(i,z);
 959   DSO_I(i,z)       = SUM(j,DSO(j,i,z));
 960   DSO_J(j,z)       = SUM(i,DSO(j,i,z));
 961   QO(i,z)         = IMTO(i,z)+DDO(i,z);
 962   
 963   MRGNO(i,z)$MRGNO(i,z)
 964                   = MRGNO(i,z)/[eO(z)*PWMGO(i)];
 965   
 966   XSO_I(i,z)      = EXTO(i,z)+DDO(i,z)+MRGNO(i,z);
 967   
 968   XSTO(j,z)       = sum(i, XSO(j,i,z));
 969   
 970   PO(i,z)        = [PETO(i,z)*EXTO(i,z)+PLO(i,z)*DSO_I(i,z)
 971                    +eO(z)*PWMGO(i)*MRGNO(i,z)]/XSO_I(i,z);
 972   
 973   PO2(j,i,z)$XSO(j,i,z) = 1;
 974   
 975   PO3(i,j,z)$XSO(j,i,z) = 1;
 976   
 977   PIO(i,z)       = SUM[j$XSO(j,i,z),PO2(J,I,z)*XSO(j,i,z)]/XSO_I(i,z);
 978   
 979   PTO(j,z)       = SUM[i$XSO(j,i,z),PO2(j,i,z)*XSO(j,i,z)]/XSTO(j,z);
 980   
 981   PPO(j,z)       = [SUM[l,TIWO(l,j,z)+WO(l,z)*LDO(l,j,z)]
 982                    +SUM[k,TIKO(k,j,z)+RKDO(k,j,z)]
 983                    +SUM[nene,DIO(nene,j,z)]+SUM[ene,DIO(ene,j,z)]]/XSTO(j,z);
 984   
 985   theta2(j,i,z) = DSO(j,i,z)/sum(jj, DSO(jj,i,z));
 986   
 987   EXTTO(j,i,z)$DSO(j,i,z) = theta2(j,i,z)*EXTO(i,z);
 988   
 989  *==============================================================================
 990  *  4.3 Calibration of tax rates, margins, prices and volumes
 991  *==============================================================================
 992  *  4.3.1 Margin rates and tax rates
 993  *==============================================================================
 994   ttixO(i,z,zj)   = [eO(z)*PWXO(i,z,zj)/PEO(i,z,zj)]-1;
 995   tticO(i,z)      = TICO(i,z)/{PLO(i,z)*DDO(i,z)
 996                     +SUM[zj,IMO(i,zj,z)*eO(z)*PWMO(i,zj,z)
 997                     +TIMO(i,zj,z)+SUM[ij,tmrg(ij,i,zj,z)]]};
 998   
 999   tmrg(i,ij,zj,z)$IMO(ij,zj,z)
1000                   = tmrg(i,ij,zj,z)/(PWMGO(i)*eO(z)*IMO(ij,zj,z));
1001   
1002   ttimO(i,zj,z)$IMO(i,zj,z)
1003                   = TIMO(i,zj,z)/{IMO(i,zj,z)*eO(z)*(PWMO(i,zj,z)
1004                    +SUM[ij,PWMGO(ij)*tmrg(ij,i,zj,z)])};
1005   
1006   ttiwO(l,j,z)$LDO(l,j,z)
1007                   = TIWO(l,j,z)/[WO(l,z)*LDO(l,j,z)];
1008   
1009   ttikO(k,j,z)$RKDO(k,j,z)
1010                   = TIKO(k,j,z)/RKDO(k,j,z);
1011   
1012   ttipO(j,z)      = [PTO(j,z)/PPO(j,z)]-1;
1013   
1014   ttdh1O(z)       = [TDHO(z)-ttdh0O(z)]/YHO(z);
1015   
1016   
