*=== Import from Excel using GDX utilities
*Unit 2019 ktoe
Parameter
WEB_KOR(flow,product),
WEB_CHN(flow,product),
WEB_JPN(flow,product),
WEB_RUS(flow,product),
WEB_MNG(flow,product),
WEB_PRK(flow,product),
WEB_NAM(flow,product),
WEB_LAM(flow,product),
WEB_WEU(flow,product),
WEB_EEU(flow,product),
WEB_FSU(flow,product),
WEB_MEA(flow,product),
WEB_AFR(flow,product),
WEB_CPA(flow,product),
WEB_SAS(flow,product),
WEB_PAS(flow,product),
WEB_PAO(flow,product)
;

$onEcho > WEB19.txt
par=WEB_KOR rng=01_KOR!A1:BQ109
par=WEB_CHN rng=02_CHN!A1:BQ109
par=WEB_JPN rng=03_JPN!A1:BQ109
par=WEB_RUS rng=04_RUS!A1:BQ109
par=WEB_MNG rng=05_MNG!A1:BQ109
par=WEB_PRK rng=06_PRK!A1:BQ109
par=WEB_NAM rng=07_NAM!A1:BQ109
par=WEB_LAM rng=08_LAM!A1:BQ109
par=WEB_WEU rng=09_WEU!A1:BQ109
par=WEB_EEU rng=10_EEU!A1:BQ109
par=WEB_FSU rng=11_FSU!A1:BQ109
par=WEB_MEA rng=12_MEA!A1:BQ109
par=WEB_AFR rng=13_AFR!A1:BQ109
par=WEB_CPA rng=14_CPA!A1:BQ109
par=WEB_SAS rng=15_SAS!A1:BQ109
par=WEB_PAS rng=16_PAS!A1:BQ109
par=WEB_PAO rng=17_PAO!A1:BQ109
$offEcho

$call gdxxrw 230217_WEB19.xlsx @WEB19.txt trace=0
$gdxIn 230217_WEB19.gdx
$load WEB_KOR WEB_CHN WEB_JPN WEB_RUS WEB_MNG WEB_PRK WEB_NAM WEB_LAM WEB_WEU WEB_EEU WEB_FSU WEB_MEA WEB_AFR WEB_CPA WEB_SAS WEB_PAS WEB_PAO

Parameter WEB(flow,product,z);
WEB(flow,product,'01_KOR') =  WEB_KOR(flow,product);
WEB(flow,product,'02_CHN') =  WEB_CHN(flow,product);
WEB(flow,product,'03_JPN') =  WEB_JPN(flow,product);
WEB(flow,product,'04_RUS') =  WEB_RUS(flow,product);
WEB(flow,product,'05_MNG') =  WEB_MNG(flow,product);
WEB(flow,product,'06_PRK') =  WEB_PRK(flow,product);
WEB(flow,product,'07_NAM') =  WEB_NAM(flow,product);
WEB(flow,product,'08_LAM') =  WEB_LAM(flow,product);
WEB(flow,product,'09_WEU') =  WEB_WEU(flow,product);
WEB(flow,product,'10_EEU') =  WEB_EEU(flow,product);
WEB(flow,product,'11_FSU') =  WEB_FSU(flow,product);
WEB(flow,product,'12_MEA') =  WEB_MEA(flow,product);
WEB(flow,product,'13_AFR') =  WEB_AFR(flow,product);
WEB(flow,product,'14_CPA') =  WEB_CPA(flow,product);
WEB(flow,product,'15_SAS') =  WEB_SAS(flow,product);
WEB(flow,product,'16_PAS') =  WEB_PAS(flow,product);
WEB(flow,product,'17_PAO') =  WEB_PAO(flow,product);

*===============================Coal============================================
*<Transformation process>
Parameter
coa_te_coal(f_coa, p_coal, z),
oil_te_coal(f_oil, p_coal, z),
gas_te_coal(f_gas, p_coal, z),
pc_te_coal(f_petrolcoal, p_coal, z),
elec_te_coal(f_elec, p_coal, z)
;

coa_te_coal(f_coa, p_coal, z) = WEB(f_coa, p_coal, z);
oil_te_coal(f_oil, p_coal, z) = WEB(f_oil, p_coal, z);
gas_te_coal(f_gas, p_coal, z) = WEB(f_gas, p_coal, z);
pc_te_coal(f_petrolcoal, p_coal, z) = WEB(f_petrolcoal, p_coal, z);
elec_te_coal(f_elec, p_coal, z) = WEB(f_elec, p_coal, z);

