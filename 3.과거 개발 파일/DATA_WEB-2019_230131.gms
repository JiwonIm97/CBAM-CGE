$Ontext
 01_AGRICULT     Agricultural forest and fishery goods
 02_COAL         Coal
 03_OIL          Crude petroleum
 04_GAS          Natural oilproduct Gas distribution
 05_MINING       Mined and quarried goods
 06_FOODPRO      Food beverages and tobacco products
 07_TEXTILES     Textile and leather products
 08_WOODPRO      Wood products
 09_PAPERPRO     Paper products
 10_PETROLCOAL   Petroleum and coal products
 11_CHEMICAL     Chemical products
 12_NONMET       Non-metallic mineral products
 13_IRONSTL      Primary iron and steel products
 14_NONFERR      Non-ferrous metal products
 15_MACHINE      Fabricated metal products Electronic and electrical equipment Machinery and equipment
 16_TRANSEQ      Motor vehicles Other transport equipment
 17_OTHERIND     Other manufactured products Water supply
 18_ELEC         Electricity
 19_CONSTRUC     Construction
 20_LTRP         Land transport service(road rail)
 21_WTRP         Water transport service
 22_ATRP         Air transport service
 23_SER          Service
$Offtext

Parameter
 EC_DIO(p_coal,j,z)              Intermediate consumption of coal by industry j in region z
 TEC_DIO(j,z)                    Total intermediate consumption of coal by industry j in region z
 EC_S(p_coal,j,z)                Intermediate consumption share of coal by industry j in region z

 NEC_DIO(p_coal,j,z)             Intermediate consumption of non-e-coal by industry j in region z

 EG_DIO(p_gas,j,z)               Intermediate consumption of gas by industry j in region z
 NEG_DIO(p_gas,j,z)              Intermediate consumption of non-e-gas by industry j in region z

 EO_DIO(p_oil,j,z)               Intermediate consumption of crudeoil by industry j in region z

 EP_DIO(p_oilproduct,j,z)        Intermediate consumption of petrolcoal by industry j in region z
 NEP_DIO(p_oilproduct,j,z)       Intermediate consumption of non-e-petrolcoal by industry j in region z

 EE_DIO(p_elec,j,z)              Intermediate consumption of electricity by industry j in region z

* EEXTO(ENE,z)       Supply of composite commodity i by region z to the export market
 EC_CO(p_coal,z)                 Household consumption of coal in region z
 EG_CO(p_gas,z)                  Household consumption of oilproduct in region z
 EO_CO(p_oil,z)                  Household consumption of crudeoil in region z
 EP_CO(p_oilproduct,z)           Household consumption of petrolcoal in region z
 EE_CO(p_elec,z)                 Household consumption of electricity in region z
;

*Coal
 EC_DIO(p_coal,'01_AGRICULT',z) = sum((f_agri), agricult_fe_coal(f_agri, p_coal, z));
 EC_DIO(p_coal,'02_COAL',z) = -1*sum((f_coa), coa_te_coal(f_coa, p_coal, z));
 EC_DIO(p_coal,'03_OIL',z) = -1*sum((f_oil), oil_te_coal(f_oil, p_coal, z));
 EC_DIO(p_coal,'04_GAS',z) = -1*sum((f_gas), gas_te_coal(f_gas, p_coal, z));
