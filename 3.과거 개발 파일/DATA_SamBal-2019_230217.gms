;

*============================Replacing Old Parameters by NSAM ==================
Parameter NSAM19(A,B,Z);
NSAM19(A,B,'01_KOR') = NSAM_01_KOR(A,B);
NSAM19(A,B,'02_CHN') = NSAM_02_CHN(A,B);
NSAM19(A,B,'03_JPN') = NSAM_03_JPN(A,B);
NSAM19(A,B,'04_RUS') = NSAM_04_RUS(A,B);
NSAM19(A,B,'05_MNG') = NSAM_05_MNG(A,B);
NSAM19(A,B,'06_PRK') = NSAM_06_PRK(A,B);
NSAM19(A,B,'07_NAM') = NSAM_07_NAM(A,B);
NSAM19(A,B,'08_LAM') = NSAM_08_LAM(A,B);
NSAM19(A,B,'09_WEU') = NSAM_09_WEU(A,B);
NSAM19(A,B,'10_EEU') = NSAM_10_EEU(A,B);
NSAM19(A,B,'11_FSU') = NSAM_11_FSU(A,B);
NSAM19(A,B,'12_MEA') = NSAM_12_MEA(A,B);
NSAM19(A,B,'13_AFR') = NSAM_13_AFR(A,B);
NSAM19(A,B,'14_CPA') = NSAM_14_CPA(A,B);
NSAM19(A,B,'15_SAS') = NSAM_15_SAS(A,B);
NSAM19(A,B,'16_PAS') = NSAM_16_PAS(A,B);
NSAM19(A,B,'17_PAO') = NSAM_17_PAO(A,B);

CO(i,Z)   = SUM[(C1,PRI1)$[sam_sce14(i,C1)], NSAM19(C1,PRI1,Z)];
CGO(i,Z)  = SUM[(C1,GOV1)$[sam_sce14(i,C1)], NSAM19(C1,GOV1,Z)];
INVO(i,Z) = SUM[(C1,INV1)$[sam_sce14(i,C1)], NSAM19(C1,INV1,Z)];
DIO(i,j,Z)= SUM[(C1,A1)$[sam_sce14(i,C1)$sam_sce13(j,A1)], NSAM19(C1,A1,Z)];
EXO(i,Z,zj) = SUM[(World1,C1)$[sam_sce24(zj,World1)$sam_sce14(i,C1)], NSAM19(C1,World1,Z)];
IMO(i,zj,Z) = SUM[(World1,C1)$[sam_sce24(zj,World1)$sam_sce14(i,C1)], NSAM19(World1,C1,Z)];

LDO(l,j,Z)  = SUM[(L1,A1)$[sam_sce15(l,L1)$sam_sce13(j,A1)], NSAM19(L1,A1,Z)];
RKDO(k,j,Z) = SUM[(K1,A1)$[sam_sce16(k,K1)$sam_sce13(j,A1)], NSAM19(K1,A1,Z)];

TDHO(Z)     = SUM[(DTX1),NSAM19(DTX1,'167_TOT',Z)];
TICO(i,Z)   = SUM[(PTX1,C1)$[sam_sce14(i,C1)], NSAM19(PTX1,C1,Z)];
TIWO(l,j,Z) = SUM[(tf1,A1)$[sam_sce17(l,tf1)$sam_sce13(j,A1)], NSAM19(tf1,A1,Z)];
TIKO(k,j,Z) = SUM[(tf2,A1)$[sam_sce18(k,tf2)$sam_sce13(j,A1)], NSAM19(tf2,A1,Z)];
TIMO(i,zj,Z)= SUM[(ITAX1,C1)$[sam_sce19(zj,ITAX1)$sam_sce14(i,C1)], NSAM19(ITAX1,C1,Z)];
TIXO(i,Z,zj)= SUM[(ETAX1,C1)$[sam_sce20(zJ,ETAX1)$sam_sce14(i,C1)], NSAM19(ETAX1,C1,Z)];
TIPO(i,Z)   = SUM[(PTX1,A1)$[sam_sce13(I,A1)], NSAM19(PTX1,A1,Z)];

MRGNO('20_LTRP',Z) = NSAM19('43_c_LTRP','142_M1c20_L_pvst',Z);
MRGNO('21_WTRP',Z) = NSAM19('44_c_WTRP','143_M2c21_W_pvst',Z);
MRGNO('22_ATRP',Z) = NSAM19('45_c_ATRP','144_M3c22_A_pvst',Z);

*Transaction cost
tmrg('20_LTRP',ij,zj,Z) = SUM[(MAR1,C1)$[sam_sce21(zj,MAR1)$sam_sce14(ij,C1)],NSAM19(MAR1,C1,Z)];
tmrg('21_WTRP',ij,zj,Z) = SUM[(MAR2,C1)$[sam_sce22(zj,MAR2)$sam_sce14(ij,C1)],NSAM19(MAR2,C1,Z)];
tmrg('22_ATRP',ij,zj,Z) = SUM[(MAR3,C1)$[sam_sce23(zj,MAR3)$sam_sce14(ij,C1)],NSAM19(MAR3,C1,Z)];

DDO(i,Z)  = CO(i,Z)+CGO(i,Z)+INVO(i,Z)+SUM[j,DIO(i,j,Z)]-TICO(i,Z)
                   -SUM[zj,TIMO(i,zj,Z)]-SUM[zj,IMO(i,zj,Z)]
                   -SUM[(ij,zj),tmrg(ij,i,zj,Z)];
DSO(i,Z)        = DDO(i,Z);
XSO(j,Z)        = DSO(j,Z)+ MRGNO(j,Z)+SUM[zj,EXO(j,Z,zj)-TIXO(j,Z,zj)];

execute_unload 'SAM-BAL-2019_230217_MNG',

*Sets used in PEP w-1 and PEP w-t
 J, I1, BUS, PUB, F, L, K, ENE, Z, ZR, Z1, Zrich, Zother

*Benchmark variables and parameters used in PEP w-1 and PEP w-t
CO, CGO, DDO, DEPO, DIO, DSO, EXO, IMO, INVO, KSTO, LDO, MRGNO, POPO, RKDO,
TDHO, TICO, TIKO, TIMO, TIPO, TIWO, TIXO, tmrg, XSO,
sigma_M1, sigma_M2, sigma_VA,Q_GTAP, SH_Q, ESUBD
;


*$exit
